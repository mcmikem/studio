/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and their associated data.
 * Public read access is granted to certain top-level collections to facilitate data sharing.
 *
 * Data Structure:
 * - User profiles are stored under `/users/{userId}`, accessible only to the user themselves.
 * - User-specific data (tasks) are stored under `/users/{userId}/tasks/{taskId}`, also accessible only to the user.
 * - Other top-level collections, such as `/checkins`, `/checkouts`, `/activities`, `/programs`, `/partnerships`, `/impact-metrics`, `/projects`, `/events`, `/alerts`, `/key-results`, `/expenses`, `/income`, `/proposals`, `/team-workplans`, `/workplans`, `/equipment`, `/task-templates`, `/messages`, `/testimonies`, `/ai-feedback` have public read access, but require authentication and validation of ownership on write operations.
 *
 * Key Security Decisions:
 * - User listing is explicitly denied for security and privacy reasons.
 * - Strict ownership is enforced for user profiles and associated data.
 * - Top-level collections allow public reads but enforce ownership on writes using an `authorId` or similar field.
 * - Denormalization: To simplify rules, we rely on the presence of `userId` fields within documents to quickly verify ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access to individual user profiles.
     * @path /users/{userId}
     * @allow (get) User with ID 'user123' can read their own profile.
     * @allow (create) User with ID 'user123' can create their profile.
     * @allow (update) User with ID 'user123' can update their own profile.
     * @allow (delete) User with ID 'user123' can delete their own profile.
     * @deny (get) User with ID 'user456' cannot read the profile of 'user123'.
     * @deny (create) User with ID 'user456' cannot create the profile of 'user123'.
     * @deny (update) User with ID 'user456' cannot update the profile of 'user123'.
     * @deny (delete) User with ID 'user456' cannot delete the profile of 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      //function
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.id == userId;
      allow delete: if isSignedIn() && isOwner(userId) && resource.data.id == userId;
    }

    /**
     * @description Grants access to tasks belonging to a specific user.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (get) User 'user123' can read their own task 'task456'.
     * @allow (create) User 'user123' can create a task.
     * @allow (update) User 'user123' can update their own task 'task456'.
     * @allow (delete) User 'user123' can delete their own task 'task456'.
     * @deny (get) User 'user456' cannot read a task belonging to 'user123'.
     * @deny (create) User 'user456' cannot create a task for 'user123'.
     * @deny (update) User 'user456' cannot update a task belonging to 'user123'.
     * @deny (delete) User 'user456' cannot delete a task belonging to 'user123'.
     * @principle Enforces document ownership for writes; allows owner-only access for reads.
     */
    match /users/{userId}/tasks/{taskId} {
      //function
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows public read access to check-in documents, but requires authentication for write operations.
     * @path /checkins/{checkinId}
     * @allow (get) Any user can read a checkin.
     * @allow (list) Any user can list checkins.
     * @allow (create) Authenticated user can create a checkin.
     * @allow (update) Fails if not authenticated.
     * @allow (delete) Fails if not authenticated.
     * @deny (create) Non-authenticated user cannot create a checkin.
     * @deny (update) Non-authenticated user cannot update a checkin.
     * @deny (delete) Non-authenticated user cannot delete a checkin.
     * @principle Allows public reads but enforces authentication for writes.
     */
    match /checkins/{checkinId} {
      //function
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows public read access to checkout documents, but requires authentication for write operations.
     * @path /checkouts/{checkoutId}
     * @allow (get) Any user can read a checkout.
     * @allow (list) Any user can list checkouts.
     * @allow (create) Authenticated user can create a checkout.
     * @allow (update) Fails if not authenticated.
     * @allow (delete) Fails if not authenticated.
     * @deny (create) Non-authenticated user cannot create a checkout.
     * @deny (update) Non-authenticated user cannot update a checkout.
     * @deny (delete) Non-authenticated user cannot delete a checkout.
     * @principle Allows public reads but enforces authentication for writes.
     */
    match /checkouts/{checkoutId} {
      //function
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows public read access to activity documents, but requires authentication for write operations and requires userId match auth.uid.
     * @path /activities/{activityId}
     * @allow (get) Any user can read an activity.
     * @allow (list) Any user can list activities.
     * @allow (create) Authenticated user can create an activity.
     * @allow (update) Fails if not authenticated or user doesn't own the activity.
     * @allow (delete) Fails if not authenticated or user doesn't own the activity.
     * @deny (create) Non-authenticated user cannot create an activity.
     * @deny (update) Non-authenticated user cannot update an activity.
     * @deny (delete) Non-authenticated user cannot delete an activity.
     * @principle Allows public reads but enforces authentication and ownership for writes.
     */
    match /activities/{activityId} {
      //function
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
          return request.auth.uid == userId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isOwner(resource.data.userId) && resource != null;
      allow delete: if isSignedIn() && isOwner(resource.data.userId) && resource != null;
    }

    /**
     * @description Allows public read access to program documents, but requires authentication for write operations.
     * @path /programs/{programId}
     * @allow (get) Any user can read a program.
     * @allow (list) Any user can list programs.
     * @allow (create) Authenticated user can create a program.
     * @allow (update) Fails if not authenticated.
     * @allow (delete) Fails if not authenticated.
     * @deny (create) Non-authenticated user cannot create a program.
     * @deny (update) Non-authenticated user cannot update a program.
     * @deny (delete) Non-authenticated user cannot delete a program.
     * @principle Allows public reads but enforces authentication for writes.
     */
    match /programs/{programId} {
      //function
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows public read access to partnership documents, but requires authentication for write operations.
     * @path /partnerships/{partnershipId}
