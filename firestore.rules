/**
 * @fileoverview Firestore Security Rules for Omuto Central.
 *
 * Core Philosophy:
 * This ruleset employs a hybrid security model, combining user-based access control with public read access for certain collections.
 * User-specific data is secured using ownership checks, while general content is publicly readable but only editable by authorized users.
 *
 * Data Structure:
 * The Firestore database is organized into top-level collections for various entities like users, programs, partnerships, activities, and checkouts.
 * User-specific data (tasks) is nested under the /users/{userId} path.
 *
 * Key Security Decisions:
 * - User listing is disallowed for privacy.
 * - Public read access is granted to top-level collections to facilitate data visibility.
 * - Write access to public collections is restricted to owners, ensuring content integrity.
 * - Strict ownership is enforced for user-specific data, preventing unauthorized access.
 *
 * Denormalization for Authorization:
 *  - The `/activities/{activityId}` documents MUST contain a `userId` field matching the user who created it. This ensures owner-only access for updates and deletes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @param {string} userId - The user's ID.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     * @returns {boolean} True if the user IDs match, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

     /**
     * @description Checks if the authenticated user is the owner of the existing document.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     * @returns {boolean} True if the user IDs match and the document exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return (isOwner(userId) && resource != null);
    }

    /**
     * @description Secures the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their own profile.
     * @allow (get, update, delete) - User with UID 'user123' can read, update, or delete their own profile.
     * @deny (create) - User with UID 'user456' cannot create a profile with ID 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures the /users/{userId}/tasks/{taskId} collection.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) - User with UID 'user123' can create a task under their profile.
     * @allow (get, update, delete) - User with UID 'user123' can read, update, or delete tasks under their profile.
     * @deny (create) - User with UID 'user456' cannot create a task under user 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures the /checkins/{checkinId} collection.
     * @path /checkins/{checkinId}
     * @allow (get, list) - Anyone can read check-in data.
     * @allow (create) - Any authenticated user can create a checkin.
     * @deny (update, delete) - No one can update or delete a checkin.
     * @principle Allows public read access, restricts write access to document creators.
     */
    match /checkins/{checkinId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Secures the /checkouts/{checkoutId} collection.
     * @path /checkouts/{checkoutId}
     * @allow (get, list) - Anyone can read checkout data.
     * @allow (create) - Any authenticated user can create a checkout.
     * @deny (update, delete) - No one can update or delete a checkout.
     * @principle Allows public read access, restricts write access to document creators.
     */
    match /checkouts/{checkoutId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Secures the /activities/{activityId} collection.
     * @path /activities/{activityId}
     * @allow (get, list) - Anyone can read activity data.
     * @allow (create) - Any authenticated user can create an activity.
     * @allow (update, delete) - Only the owner can update or delete the activity.
     * @principle Allows public read access, restricts write access to document creators.
     */
    match /activities/{activityId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.userId);
      allow delete: if isExistingOwner(resource.data.userId);
    }

    /**
     * @description Secures the /programs/{programId} collection.
     * @path /programs/{programId}
     * @allow (get, list) - Anyone can read program data.
     * @allow (create) - Any authenticated user can create a program.
     * @deny (update, delete) - No one can update or delete a program.
     * @principle Allows public read access, restricts write access to document creators.
     */
    match /programs/{programId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Secures the /partnerships/{partnershipId} collection.
     * @path /partnerships/{partnershipId}
     * @allow (get, list) - Anyone can read partnership data.
     * @allow (create) - Any authenticated user can create a partnership.
     * @deny (update, delete) - No one can update or delete a partnership.
     * @principle Allows public read access, restricts write access to document creators.
     */
    match /partnerships/{partnershipId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Secures the /impact-metrics/{metricId} collection.
     * @path /impact-metrics/{metricId}
     * @allow (get, list) - Anyone can read impact metric data.
     * @allow (create) - Any authenticated user can create an impact metric.
     * @deny (update, delete) - No one can update or delete an impact metric.
     * @principle Allows public read access, restricts write access to document creators.
     */
    match /impact-metrics/{metricId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

     /**
     * @description Secures the /projects/{projectId} collection.
     * @path /projects/{projectId}
     * @allow (get, list) - Anyone can read project data.
     * @allow (create) - Any authenticated user can create a project.
     * @deny (update, delete) - No one can update or delete a project.
     * @principle Allows public read access, restricts write access to document creators.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Secures the /events/{eventId} collection.
     * @path /events/{eventId}
     * @allow (get, list) - Anyone can read calendar event data.
     * @allow (create) - Any authenticated user can create a calendar event.
     * @deny (update, delete) - No one can update or delete a calendar event.
     * @principle Allows public read access, restricts write access to document creators.
     */
    match /events/{eventId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Secures the /alerts/{alertId} collection.
     * @path /alerts/{alertId}
     * @allow (get, list) - Anyone can read alert data.
     * @allow (create) - Any authenticated user can create an alert.
     * @deny (update, delete) - No one can update or delete an alert.
     * @principle Allows public read access, restricts write access to document creators.
     */
    match /alerts/{alertId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Secures the /key-results/{keyResultId} collection.
     * @path /key-results/{keyResultId}
     * @allow (get, list) - Anyone can read key result data.
     * @allow (create) - Any authenticated user can create a key result.
     * @deny (update, delete) - No one can update or delete a key result.
     * @principle Allows public read access, restricts write access to document creators.
     */
    match /key-results/{keyResultId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Secures the /expenses/{expenseId} collection.
     * @path /expenses/{expenseId}
     * @allow (get, list) - Anyone can read expense data.
     * @allow (create) - Any authenticated user can create an expense.
     * @deny (update, delete) - No one can update or delete an expense.
     * @principle Allows public read access, restricts write access to document creators.
     */
    match /expenses/{expenseId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}