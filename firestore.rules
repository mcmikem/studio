    /**
     * @description Allows any authenticated user to create, read, update, or delete a key result.
     * @path /key-results/{keyResultId}
     * @allow (create) - Any authenticated user can create a key result.
     * @allow (get, list) - Any authenticated user can read key results.
     * @allow (update, delete) - Any authenticated user can update or delete a key result.
     * @principle Allows authenticated access to key result data.
     */
    match /key-results/{keyResultId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
