
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    // Default-deny all reads and writes to prevent accidental access.
    match /{document=**} {
      allow read, write: if false;
    }

    // /users/{userId}
    // Users can read their own profile.
    // Any authenticated user can list all user profiles for team views.
    // Users can create and update their own profile.
    match /users/{userId} {
      allow get, update, create: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn();
    }

    // /users/{userId}/tasks/{taskId}
    // Users can only manage their own tasks.
    match /users/{userId}/tasks/{taskId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // General collections for organizational data.
    // Any signed-in user can read, create, update, and delete documents in these collections.
    // This is a permissive rule for internal tools to ensure functionality.
    match /checkins/{checkinId} {
      allow read, write: if isSignedIn();
    }
    match /checkouts/{checkoutId} {
      allow read, write: if isSignedIn();
    }
    match /activities/{activityId} {
      allow read, write: if isSignedIn();
    }
    match /programs/{programId} {
      allow read, write: if isSignedIn();
    }
    match /partnerships/{partnershipId} {
      allow read, write: if isSignedIn();
    }
    match /impact-metrics/{metricId} {
      allow read, write: if isSignedIn();
    }
    match /projects/{projectId} {
      allow read, write: if isSignedIn();
    }
    match /events/{eventId} {
      allow read, write: if isSignedIn();
    }
    match /alerts/{alertId} {
      allow read, write: if isSignedIn();
    }
    match /key-results/{keyResultId} {
      allow read, write: if isSignedIn();
    }
    match /expenses/{expenseId} {
      allow read, write: if isSignedIn();
    }
  }
}
