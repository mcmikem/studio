rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces owner-only access to user profile data.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' creates their profile.
     * @deny (create) User with ID 'user123' attempts to create profile for 'otherUser'.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // User listing is disabled.

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces owner-only access to user tasks.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) User with ID 'user123' creates a task.
     * @deny (create) User with ID 'user123' attempts to create a task for 'otherUser'.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to check-in documents, but restricts write access to authenticated users.
     * @path /checkins/{checkinId}
     * @allow (get) Any user can retrieve a check-in.
     * @allow (list) Any user can list check-ins.
     * @allow (create) Any authenticated user can create a check-in.
     * @deny (create) Unauthenticated user attempts to create a check-in.
     * @principle Allows public read access while restricting writes to authenticated users.
     */
    match /checkins/{checkinId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && request.auth.uid == resource.data.uid;
    }

     /**
     * @description Allows public read access to checkout documents, but restricts write access to authenticated users.
     * @path /checkouts/{checkoutId}
     * @allow (get) Any user can retrieve a checkout.
     * @allow (list) Any user can list checkouts.
     * @allow (create) Any authenticated user can create a checkout.
     * @deny (create) Unauthenticated user attempts to create a checkout.
     * @principle Allows public read access while restricting writes to authenticated users.
     */
    match /checkouts/{checkoutId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && request.auth.uid == resource.data.uid;
    }

