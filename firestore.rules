/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @description This ruleset enforces a strict user-ownership model for user-specific data
 * and allows public read access for certain top-level collections while restricting writes to authorized users.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles. Only the authenticated user can read/write their own profile.
 * - /users/{userId}/tasks/{taskId}: Stores tasks for each user. Only the authenticated user can read/write their own tasks.
 * - /checkouts/{checkoutId}: Stores daily checkouts.  Anyone can read checkouts. Only the user who owns the record can create, update, or delete it.
 * - /activities/{activityId}: Stores logged activities. Anyone can read logged activities. Only the user who owns the record can create, update, or delete it.
 * - /programs/{programId}: Stores core programs and initiatives. Anyone can read programs. Only the user who owns the record can create, update, or delete it.
 * - /partnerships/{partnershipId}: Stores partnership information. Anyone can read partnerships. Only the user who owns the record can create, update, or delete it.
 *
 * Key Security Decisions:
 * - User listing is explicitly denied.
 * - All write operations require user authentication.
 * - Public read access is granted to /checkouts, /activities, /programs, and /partnerships, assuming they are intended to be publicly viewable.
 * - Ownership is enforced via the userId field in relevant documents.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces ownership for user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile if authenticated as 'user123'.
     * @allow (get) User with ID 'user123' can read their profile if authenticated as 'user123'.
     * @allow (update) User with ID 'user123' can update their profile if authenticated as 'user123'.
     * @allow (delete) User with ID 'user123' can delete their profile if authenticated as 'user123'.
     * @deny (create) User with ID 'user123' cannot create a profile if authenticated as 'user456'.
     * @deny (get) User with ID 'user123' cannot read the profile if unauthenticated.
     * @principle Enforces document ownership for writes and requires authentication for reads.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces ownership for tasks within a user's profile.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) User with ID 'user123' can create a task under their profile if authenticated as 'user123'.
     * @allow (get) User with ID 'user123' can read a task under their profile if authenticated as 'user123'.
     * @allow (update) User with ID 'user123' can update a task under their profile if authenticated as 'user123'.
     * @allow (delete) User with ID 'user123' can delete a task under their profile if authenticated as 'user123'.
     * @deny (create) User with ID 'user123' cannot create a task under another user's profile.
     * @deny (get) User with ID 'user123' cannot read a task under another user's profile.
     * @principle Restricts access to a user's own data tree and validates relational integrity.
     */
    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

        /**
     * @description Allows public read access to checkouts, while restricting write access to the owner.
     * @path /checkouts/{checkoutId}
     * @allow (get) Any user can read a checkout.
     * @allow (list) Any user can list checkouts.
     * @allow (create) User with ID 'user123' can create a checkout if authenticated as 'user123'.
     * @allow (update) User with ID 'user123' can update their checkout if authenticated as 'user123'.
     * @allow (delete) User with ID 'user123' can delete their checkout if authenticated as 'user123'.
     * @deny (create) User with ID 'user123' cannot create a checkout with userId 'user456'.
     * @deny (update) User with ID 'user123' cannot update a checkout they don't own.
     * @principle Public read access with owner-only writes, validates userId on create.
     */
    match /checkouts/{checkoutId} {
        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && isExistingOwnerOfCheckout(request.resource.data.userId);
        allow delete: if isSignedIn() && isExistingOwnerOfCheckout(request.resource.data.userId);
    }

        /**
     * @description Allows public read access to activities, while restricting write access to the owner.
     * @path /activities/{activityId}
     * @allow (get) Any user can read an activity.
     * @allow (list) Any user can list activities.
     * @allow (create) User with ID 'user123' can create an activity if authenticated as 'user123'.
     * @allow (update) User with ID 'user123' can update their activity if authenticated as 'user123'.
     * @allow (delete) User with ID 'user123' can delete their activity if authenticated as 'user123'.
     * @deny (create) User with ID 'user123' cannot create an activity with userId 'user456'.
     * @deny (update) User with ID 'user123' cannot update an activity they don't own.
     * @principle Public read access with owner-only writes, validates userId on create.
     */
    match /activities/{activityId} {
        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && isExistingOwnerOfActivity(request.resource.data.userId);
        allow delete: if isSignedIn() && isExistingOwnerOfActivity(request.resource.data.userId);
    }

        /**
     * @description Allows public read access to programs, while restricting write access to the owner.
     * @path /programs/{programId}
     * @allow (get) Any user can read a program.
     * @allow (list) Any user can list programs.
     * // CRITICAL: Cannot implement owner-only writes. The 'Program' entity is missing an 'ownerId' or 'authorId' field.
     * @deny (create) User with ID 'user123' cannot create a program.
     * @deny (update) User with ID 'user123' cannot update a program they don't own.
     * @principle Public read access, but owner-only writes cannot be implemented without an owner field.
     */
    match /programs/{programId} {
        allow get: if true;
        allow list: if true;
        allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows public read access to partnerships, while restricting write access to the owner.
     * @path /partnerships/{partnershipId}
     * @allow (get) Any user can read a partnership.
     * @allow (list) Any user can list partnerships.
     * // CRITICAL: Cannot implement owner-only writes. The 'Partnership' entity is missing an 'ownerId' or 'authorId' field.
     * @deny (create) User with ID 'user123' cannot create a partnership.
     * @deny (update) User with ID 'user123' cannot update a partnership they don't own.
     * @principle Public read access, but owner-only writes cannot be implemented without an owner field.
     */
    match /partnerships/{partnershipId} {
        allow get: if true;
        allow list: if true;
        allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isSignedIn() && isOwner(userId) && resource != null;
    }

    function isExistingOwnerOfCheckout(userId) {
        return isOwner(userId) && resource != null && resource.data.userId == request.auth.uid;
    }

    function isExistingOwnerOfActivity(userId) {
        return isOwner(userId) && resource != null && resource.data.userId == request.auth.uid;
    }
  }
}