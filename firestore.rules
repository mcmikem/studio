    /**
     * @description Allows public read access to alert documents, but requires authentication and creatorId match auth.uid for write operations.
     * @path /alerts/{alertId}
     * @allow (get) Any user can read an alert.
     * @allow (list) Any user can list alerts.
     * @allow (create) Authenticated user can create an alert.
     * @allow (update) Fails if not authenticated or user doesn't own the alert.
     * @allow (delete) Fails if not authenticated or user doesn't own the alert.
     * @deny (create) Non-authenticated user cannot create an alert.
     * @deny (update) Non-authenticated user cannot update an alert.
     * @deny (delete) Non-authenticated user cannot delete an alert.
     * @principle Allows public reads but enforces authentication and ownership for writes.
     */
    match /alerts/{alertId} {
      //function
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(creatorId) {
          return request.auth.uid == creatorId;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isSignedIn() && isOwner(resource.data.creatorId) && resource != null;
      allow delete: if isSignedIn() && isOwner(resource.data.creatorId) && resource != null;
    }

    /**
