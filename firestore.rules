/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a user-ownership model for user profiles
 * and allows only authenticated users to list `checkouts`. The rules are designed
 * to provide a secure foundation for the Omuto Central application while
 * allowing for flexible data shapes during the prototyping phase.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, accessible only to the user themselves.
 * - /checkouts/{checkoutId}: Stores daily checkout updates, listable by any authenticated user.
 *
 * Key Security Decisions:
 * - User listing is disallowed to prevent unauthorized access to user information.
 * - `checkouts` are readable by all authenticated users but only created (and potentially updated/deleted in the future) by authenticated users.
 *
 * Denormalization for Authorization:
 * - The `Checkout` document requires the `userId` field to match the authenticated user's UID to enforce ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for user profiles. Only the
     *  authenticated user can read, update, or delete their own profile.
     * @path /users/{userId}
     * @allow (get, update, delete) if the request is made by the user with matching {userId}.
     * @allow (create) if the authenticated user's UID matches the {userId} and the document's `id` field.
     * @deny (get, update, delete) if the request is made by a different user.
     * @deny (create) if the authenticated user's UID does not match the {userId}.
     * @deny (list) All users are denied to list users.
     * @principle Enforces strict user-ownership for all operations.
     */
    match /users/{userId} {
      // Validate the user ID
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Check if a user exists and is the owner
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      // Only allow a user to create their own document.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow get: if isOwner(userId);
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
      allow list: if false;
    }

    /**
     * @description Allows authenticated users to list `checkouts`. `create` is allowed if the user is authenticated and the `userId` field matches their UID.
     * @path /checkouts/{checkoutId}
     * @allow (list) if the request is made by an authenticated user.
     * @allow (create) if the request is made by an authenticated user, and the `userId` field in the document matches their UID.
     * @deny (create, update, delete) if the request is not made by the owner.
     * @deny (get) if the user is not authenticated.
     * @principle Allows public read, but restricts write access to authenticated users.
     */
    match /checkouts/{checkoutId} {
      // Validate the user ID
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

       // Check if a user exists and is the owner
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(resource.data.userId);
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}