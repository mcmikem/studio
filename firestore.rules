/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for most collections,
 *              allowing only authenticated users to read and write their own data.
 *
 * Data Structure:
 * - User profiles are stored under `/users/{userId}`.
 * - User-specific data (tasks) is stored under `/users/{userId}/tasks/{taskId}`.
 * - Other collections like `/checkins`, `/checkouts`, `/activities`, etc., are top-level.
 *
 * Key Security Decisions:
 * - User listing is disallowed to prevent unauthorized access to user data.
 * - Most write operations require the user to be the owner of the resource.
 * - No schema validation is performed beyond authorization-critical fields, allowing for rapid iteration.
 * - Public read access is NOT granted to any collection containing private user data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by an authenticated user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided userId.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner and the resource exists.
     * @param {string} userId - The user ID to compare against the authenticated user's ID.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Enforces owner-only access to user profiles.
     * @path /users/{userId}
     * @allow (create) - Authenticated user with ID 'user_abc' can create their profile at /users/user_abc.
     * @allow (get, update, delete) - Authenticated user with ID 'user_abc' can access their profile at /users/user_abc.
     * @deny (create) - Authenticated user with ID 'user_xyz' cannot create a profile at /users/user_abc.
     * @deny (get, update, delete) - Authenticated user with ID 'user_xyz' cannot access the profile at /users/user_abc.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // User listing is not allowed.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces owner-only access to tasks for a specific user.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) - Authenticated user with ID 'user_abc' can create a task under /users/user_abc/tasks/task_123.
     * @allow (get, update, delete) - Authenticated user with ID 'user_abc' can access their task at /users/user_abc/tasks/task_123.
     * @deny (create) - Authenticated user with ID 'user_xyz' cannot create a task under /users/user_abc/tasks/task_123.
     * @deny (get, update, delete) - Authenticated user with ID 'user_xyz' cannot access the task at /users/user_abc/tasks/task_123.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows any authenticated user to create, read, update, or delete a checkin.
     * @path /checkins/{checkinId}
     * @allow (create) - Any authenticated user can create a checkin.
     * @allow (get, list) - Any authenticated user can read checkins.
     * @allow (update, delete) - Any authenticated user can update or delete a checkin.
     * @principle Allows authenticated access to checkin data.
     */
    match /checkins/{checkinId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows any authenticated user to create, read, update, or delete a checkout.
     * @path /checkouts/{checkoutId}
     * @allow (create) - Any authenticated user can create a checkout.
     * @allow (get, list) - Any authenticated user can read checkouts.
     * @allow (update, delete) - Any authenticated user can update or delete a checkout.
     * @principle Allows authenticated access to checkout data.
     */
    match /checkouts/{checkoutId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

   /**
     * @description Allows any authenticated user to create, read, update, or delete an activity.
     * @path /activities/{activityId}
     * @allow (create) - Any authenticated user can create an activity.
     * @allow (get, list) - Any authenticated user can read activities.
     * @allow (update, delete) - Any authenticated user can update or delete an activity.
     * @principle Allows authenticated access to activity data.
     */
    match /activities/{activityId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
