/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user-specific data and provides public read access to several top-level collections.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data. Only the authenticated user can read/write their own profile.
 * - /users/{userId}/tasks/{taskId}: Stores tasks for a specific user. Only the authenticated user can manage their own tasks.
 * - /checkins/{checkinId}: Stores daily check-in plans.
 * - /checkouts/{checkoutId}: Stores daily checkout updates.
 * - /activities/{activityId}: Stores logged activities from the ROI Calculator.
 * - /programs/{programId}: Stores Omuto's core programs.
 * - /partnerships/{partnershipId}: Stores information about partner organizations.
 * - /impact-metrics/{metricId}: Stores key performance indicators (KPIs).
 * - /projects/{projectId}: Stores high-level projects.
 * - /events/{eventId}: Stores organizational calendar events.
 * - /alerts/{alertId}: Stores system-wide alerts and notifications.
 * - /key-results/{keyResultId}: Stores key results for the October Operational Plan.
 * - /expenses/{expenseId}: Stores expense reports submitted by users.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Public read access is granted to /checkins, /checkouts, /activities, /programs, /partnerships, /impact-metrics, /projects, /events, /alerts, /key-results, and /expenses.
 * - All write operations require user authentication.
 *
 * Denormalization for Authorization:
 *   The current rules do not require denormalization.  All ownership checks can be performed against the `request.auth.uid` and the document path.
 *
 * Structural Segregation:
 *   The app uses separate collections for public (e.g., /programs) and private (e.g., /users/{userId}) data, which improves security and performance.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the existing owner of the document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Grants access to user profile documents.
     * @path /users/{userId}
     * @allow (create) - User 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can create their own profile document.
     * @allow (get) - User 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can read their own profile document.
     * @allow (update) - User 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can update their own profile document.
     * @allow (delete) - User 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can delete their own profile document.
     * @deny (create) - User 'someOtherUserId' cannot create a profile document for 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to tasks subcollection for a specific user.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) - User 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can create a task under their profile.
     * @allow (get) - User 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can read a task under their profile.
     * @allow (update) - User 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can update a task under their profile.
     * @allow (delete) - User 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can delete a task under their profile.
     * @deny (create) - User 'someOtherUserId' cannot create a task under user 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1''s profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants public read access to check-in documents and requires authentication for write operations.
     * @path /checkins/{checkinId}
     * @allow (get, list) - Any user, signed in or not, can read check-in documents.
     * @allow (create) - Authenticated user 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can create a check-in document.
     * @deny (update, delete) - Only authenticated users can perform these operations.
     * @principle Allows public read access with authenticated writes.
     */
    match /checkins/{checkinId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Grants public read access to checkout documents and requires authentication for write operations.
     * @path /checkouts/{checkoutId}
     * @allow (get, list) - Any user, signed in or not, can read checkout documents.
     * @allow (create) - Authenticated user 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can create a checkout document.
     * @deny (update, delete) - Only authenticated users can perform these operations.
     * @principle Allows public read access with authenticated writes.
     */
    match /checkouts/{checkoutId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Grants public read access to activity documents and requires authentication for write operations.
     * @path /activities/{activityId}
     * @allow (get, list) - Any user, signed in or not, can read activity documents.
     * @allow (create) - Authenticated user 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can create an activity document.
     * @deny (update, delete) - Only authenticated users can perform these operations.
     * @principle Allows public read access with authenticated writes.
     */
    match /activities/{activityId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Grants public read access to program documents and requires authentication for write operations.
     * @path /programs/{programId}
     * @allow (get, list) - Any user, signed in or not, can read program documents.
     * @allow (create) - Authenticated user 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can create a program document.
     * @deny (update, delete) - Only authenticated users can perform these operations.
     * @principle Allows public read access with authenticated writes.
     */
    match /programs/{programId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Grants public read access to partnership documents and requires authentication for write operations.
     * @path /partnerships/{partnershipId}
     * @allow (get, list) - Any user, signed in or not, can read partnership documents.
     * @allow (create) - Authenticated user 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can create a partnership document.
     * @deny (update, delete) - Only authenticated users can perform these operations.
     * @principle Allows public read access with authenticated writes.
     */
    match /partnerships/{partnershipId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Grants public read access to impact metric documents and requires authentication for write operations.
     * @path /impact-metrics/{metricId}
     * @allow (get, list) - Any user, signed in or not, can read impact metric documents.
     * @allow (create) - Authenticated user 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can create an impact metric document.
     * @deny (update, delete) - Only authenticated users can perform these operations.
     * @principle Allows public read access with authenticated writes.
     */
    match /impact-metrics/{metricId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Grants public read access to project documents and requires authentication for write operations.
     * @path /projects/{projectId}
     * @allow (get, list) - Any user, signed in or not, can read project documents.
     * @allow (create) - Authenticated user 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can create a project document.
     * @deny (update, delete) - Only authenticated users can perform these operations.
     * @principle Allows public read access with authenticated writes.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Grants public read access to event documents and requires authentication for write operations.
     * @path /events/{eventId}
     * @allow (get, list) - Any user, signed in or not, can read event documents.
     * @allow (create) - Authenticated user 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can create an event document.
     * @deny (update, delete) - Only authenticated users can perform these operations.
     * @principle Allows public read access with authenticated writes.
     */
    match /events/{eventId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Grants public read access to alert documents and requires authentication for write operations.
     * @path /alerts/{alertId}
     * @allow (get, list) - Any user, signed in or not, can read alert documents.
     * @allow (create) - Authenticated user 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can create an alert document.
     * @deny (update, delete) - Only authenticated users can perform these operations.
     * @principle Allows public read access with authenticated writes.
     */
    match /alerts/{alertId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

   /**
     * @description Grants public read access to key result documents and requires authentication for write operations.
     * @path /key-results/{keyResultId}
     * @allow (get, list) - Any user, signed in or not, can read key result documents.
     * @allow (create) - Authenticated user 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can create a key result document.
     * @deny (update, delete) - Only authenticated users can perform these operations.
     * @principle Allows public read access with authenticated writes.
     */
    match /key-results/{keyResultId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Grants public read access to expense documents and requires authentication for write operations.
     * @path /expenses/{expenseId}
     * @allow (get, list) - Any user, signed in or not, can read expense documents.
     * @allow (create) - Authenticated user 'Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1' can create an expense document.
     * @deny (update, delete) - Only authenticated users can perform these operations.
     * @principle Allows public read access with authenticated writes.
     */
    match /expenses/{expenseId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}