/**
 * @file Firestore Security Rules
 * @description This ruleset provides demo access to the entire Omuto Central application without security limitations.
 *
 * Core Philosophy:
 * This ruleset grants full read and write access to all authenticated users for demonstration purposes.  It is NOT intended for production use.
 *
 * Data Structure:
 * The Firestore database contains top-level collections for users, checkouts, activities, programs, and partnerships.
 *
 * Key Security Decisions:
 * All authenticated users can read and write all data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows any authenticated user to read and write user profile information.
     * @path /users/{userId}
     * @allow (get, list, create, update, delete) - Any signed-in user can perform any operation.
     * @deny (none) - No requests are denied.
     * @principle Grants full access for demo purposes.
     */
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read and write checkout updates.
     * @path /checkouts/{checkoutId}
     * @allow (get, list, create, update, delete) - Any signed-in user can perform any operation.
     * @deny (none) - No requests are denied.
     * @principle Grants full access for demo purposes.
     */
    match /checkouts/{checkoutId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read and write activity logs.
     * @path /activities/{activityId}
     * @allow (get, list, create, update, delete) - Any signed-in user can perform any operation.
     * @deny (none) - No requests are denied.
     * @principle Grants full access for demo purposes.
     */
    match /activities/{activityId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read and write program data.
     * @path /programs/{programId}
     * @allow (get, list, create, update, delete) - Any signed-in user can perform any operation.
     * @deny (none) - No requests are denied.
     * @principle Grants full access for demo purposes.
     */
    match /programs/{programId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to read and write partnership data.
     * @path /partnerships/{partnershipId}
     * @allow (get, list, create, update, delete) - Any signed-in user can perform any operation.
     * @deny (none) - No requests are denied.
     * @principle Grants full access for demo purposes.
     */
    match /partnerships/{partnershipId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Global helper function to check if a user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }
  }
}