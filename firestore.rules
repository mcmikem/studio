/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user-specific data and provides public read access to some collections.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles. Access is restricted to the owning user.
 * - /users/{userId}/tasks/{taskId}: Subcollection for user-specific tasks. Access is restricted to the owning user.
 * - /checkouts/{checkoutId}: Stores daily checkout updates.
 * - /activities/{activityId}: Stores logged activities.
 * - /programs/{programId}: Stores core programs and initiatives. Public read access, owner-only writes.
 * - /partnerships/{partnershipId}: Stores partner organization information. Public read access, owner-only writes.
 *
 * Key Security Decisions:
 * - Users can only access their own profile data under /users/{userId}.
 * - Listing of users is disallowed.
 * - Public read access is granted for /programs and /partnerships, but writes are restricted to the owner. The owner must be specified within the document when it is created.
 *
 * Denormalization for Authorization:
 * - For public read collections with owner-only writes (e.g., /programs, /partnerships), the documents must include an `ownerId` or `authorId` field that matches the user's UID. This is enforced on create and update.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own user profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if request.auth.uid == userId
     * @deny (get, create, update, delete) if request.auth.uid != userId
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows a user to manage their own tasks.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (get, create, update, delete) if request.auth.uid == userId
     * @deny (get, create, update, delete) if request.auth.uid != userId
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows anyone to read checkouts, but only the owner can create, update, or delete their own checkout.
     * @path /checkouts/{checkoutId}
     */
    match /checkouts/{checkoutId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && request.auth.uid == request.resource.data.userId && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == request.resource.data.userId && request.auth.uid == resource.data.userId;
    }

    /**
     * @description Allows anyone to read activities, but only the owner can create, update, or delete their own activity.
     * @path /activities/{activityId}
     */
    match /activities/{activityId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && request.auth.uid == request.resource.data.userId && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == request.resource.data.userId && request.auth.uid == resource.data.userId;
    }

     /**
      * @description Allows anyone to read programs, but only the owner can create, update, or delete programs.
      * @path /programs/{programId}
      */
    match /programs/{programId} {
        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;
        allow update: if isSignedIn() && request.auth.uid == request.resource.data.ownerId && request.auth.uid == resource.data.ownerId;
        allow delete: if isSignedIn() && request.auth.uid == request.resource.data.ownerId && request.auth.uid == resource.data.ownerId;
    }

    /**
     * @description Allows anyone to read partnerships, but only the owner can create, update, or delete partnerships.
     * @path /partnerships/{partnershipId}
     */
    match /partnerships/{partnershipId} {
        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;
        allow update: if isSignedIn() && request.auth.uid == request.resource.data.ownerId && request.auth.uid == resource.data.ownerId;
        allow delete: if isSignedIn() && request.auth.uid == request.resource.data.ownerId && request.auth.uid == resource.data.ownerId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}