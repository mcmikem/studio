     * @allow (list) Any user can list programs.
     * @allow (create) Any authenticated user can create a program.
     * @deny (create) Unauthenticated user attempts to create a program.
     * @principle Allows public read access while restricting writes to authenticated users.
     */
    match /programs/{programId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null; // CRITICAL: Cannot implement owner-only writes. The 'Program' entity is missing an 'ownerId' or 'authorId' field.
    }

    /**
     * @description Allows public read access to partnership documents, but restricts write access to authenticated users.
     * @path /partnerships/{partnershipId}
     * @allow (get) Any user can retrieve a partnership.
     * @allow (list) Any user can list partnerships.
     * @allow (create) Any authenticated user can create a partnership.
     * @deny (create) Unauthenticated user attempts to create a partnership.
     * @principle Allows public read access while restricting writes to authenticated users.
     */
    match /partnerships/{partnershipId} {
      allow get: if true;
