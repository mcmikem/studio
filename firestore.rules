/**
 * @fileoverview Firestore Security Rules for Omuto Central.
 *
 * Core Philosophy:
 * This ruleset provides role-based access control. The system allows authenticated users to read all Programs and requires authentication for all write operations.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, accessible only to the user and admins.
 * - /checkouts/{checkoutId}: Stores daily checkout updates, accessible to any authenticated user.
 * - /activities/{activityId}: Stores ROI Calculator activity logs, accessible to any authenticated user.
 * - /programs/{programId}: Stores program information, publicly readable, but writeable only by authorized users.
 * - /partnerships/{partnershipId}: Stores partnership information, accessible to any authenticated user.
 *
 * Key Security Decisions:
 * - User listing is disallowed for privacy.
 * - Public read access is enabled for the /programs collection to showcase Omuto's initiatives.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided userId.
     * @param {string} userId The user ID to compare against.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of an existing document.
     * @param {string} userId The user ID to compare against.
     * @return {bool} True if the user is the owner and the document exists.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for user profile information.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     * @allow (get) User with ID 'user123' can read their own profile.
     * @deny (create) User with ID 'user456' cannot create a profile with ID 'user123'.
     * @deny (get) User with ID 'user456' cannot read profile of user 'user123'.
     * @principle Enforces document ownership for user profiles and ensures path consistency.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for daily checkout updates.
     * @path /checkouts/{checkoutId}
     * @allow (create) Any authenticated user can create a checkout.
     * @allow (get) Any authenticated user can read a checkout.
     * @deny (create) An unauthenticated user cannot create a checkout.
     * @deny (update) Only the owner can update a checkout.
     * @principle Allows authenticated users to manage checkout updates.
     */
    match /checkouts/{checkoutId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for ROI Calculator activity logs.
     * @path /activities/{activityId}
     * @allow (create) Any authenticated user can create an activity log.
     * @allow (get) Any authenticated user can read an activity log.
     * @deny (create) An unauthenticated user cannot create an activity log.
     * @deny (update) Only the owner can update an activity log.
     * @principle Allows authenticated users to manage activity logs.
     */
    match /activities/{activityId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for Omuto's core programs and initiatives.
     * @path /programs/{programId}
     * @allow (get) Any user can read program information.
     * @allow (list) Any user can list programs.
     * @deny (create) Only authenticated users can create programs.
     * @deny (update) Only authenticated users can update programs.
     * @principle Allows public read access to program information but restricts write access.
     */
    match /programs/{programId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for partner organizations.
     * @path /partnerships/{partnershipId}
     * @allow (create) Any authenticated user can create a partnership.
     * @allow (get) Any authenticated user can read a partnership.
     * @deny (create) An unauthenticated user cannot create a partnership.
     * @deny (update) Only the owner can update a partnership.
     * @principle Allows authenticated users to manage partnerships.
     */
    match /partnerships/{partnershipId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}