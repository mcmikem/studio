      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows any authenticated user to create, read, update, or delete an expense.
     * @path /expenses/{expenseId}
     * @allow (create) - Any authenticated user can create an expense.
     * @allow (get, list) - Any authenticated user can read expenses.
