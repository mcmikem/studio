rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided user ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the existing document.
     */
    function isExistingOwner() {
      return resource.data.userId == request.auth.uid;
    }

    /**
     * @description Enforces that on creation, the `userId` field within the document matches the `userId` in the path.
     * @param {string} userId The user ID from the path.
     * @return {bool} Whether the validation passes.
     */
    function isValidOwnerOnCreate(userId) {
      return request.resource.data.userId == userId;
    }

    /**
     * @description Enforces immutability of the `userId` field on updates.
     * @param {string} userId The user ID from the path.
     * @return {bool} Whether the validation passes.
     */
    function isValidOwnerOnUpdate(userId) {
      return request.resource.data.userId == resource.data.userId;
    }

    /**
     * @description Security rules for user profiles.
     * @path /users/{userId}
     * @allow (create) User 'testUID' can create their own profile if `request.auth.uid` matches `{userId}`.
     * @allow (get) User 'testUID' can read their own profile if `request.auth.uid` matches `{userId}`.
     * @allow (update) User 'testUID' can update their own profile if `request.auth.uid` matches `{userId}`.
     * @allow (delete) User 'testUID' can delete their own profile if `request.auth.uid` matches `{userId}`.
     * @deny (create) User 'otherUID' cannot create a profile with `{userId}` set to 'testUID'.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Security rules for tasks within a user's profile.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) User 'testUID' can create a task under their profile if `request.auth.uid` matches `{userId}`.
     * @allow (get) User 'testUID' can read a task under their profile if `request.auth.uid` matches `{userId}`.
     * @allow (update) User 'testUID' can update a task under their profile if `request.auth.uid` matches `{userId}`.
     * @allow (delete) User 'testUID' can delete a task under their profile if `request.auth.uid` matches `{userId}`.
     * @deny (create) User 'otherUID' cannot create a task under user 'testUID'.
     * @principle Enforces document ownership for tasks, nested under user profiles.
     */
    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Security rules for daily check-in plans.
     * @path /checkins/{checkinId}
     * @allow (get) Any user can read all check-ins.
     * @allow (list) Any user can list all check-ins.
     * @allow (create) Any signed-in user can create a check-in.
     * @allow (update) No one can update a checkin
     * @allow (delete) No one can delete a checkin
     * @deny (create) An unauthenticated user cannot create a check-in.
     * @principle Allows public read access to check-ins while requiring authentication for creation.
     */
    match /checkins/{checkinId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Security rules for daily checkout updates.
     * @path /checkouts/{checkoutId}
     * @allow (get) Any user can read all checkouts.
     * @allow (list) Any user can list all checkouts.
     * @allow (create) Any signed-in user can create a checkout.
     * @allow (update) No one can update a checkout.
     * @allow (delete) No one can delete a checkout.
     * @deny (create) An unauthenticated user cannot create a checkout.
     * @principle Allows public read access to checkouts while requiring authentication for creation.
     */
    match /checkouts/{checkoutId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Security rules for ROI Calculator logs.
     * @path /activities/{activityId}
     * @allow (get) Any user can read all activities.
     * @allow (list) Any user can list all activities.
     * @allow (create) Any signed-in user can create an activity log.
     * @allow (update) No one can update an activity.
     * @allow (delete) No one can delete an activity.
     * @deny (create) An unauthenticated user cannot create an activity log.
     * @principle Allows public read access to activity logs while requiring authentication for creation.
     */
    match /activities/{activityId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Security rules for Omuto's core programs and initiatives.
     * @path /programs/{programId}
     * @allow (get) Any user can read program details.
     * @allow (list) Any user can list programs.
     * @allow (create) Any signed-in user can create a program.
     * @allow (update) No one can update a program.
     * @allow (delete) No one can delete a program.
     * @deny (create) An unauthenticated user cannot create a program.
     * @principle Allows public read access to programs while requiring authentication for creation.
     */
    match /programs/{programId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Security rules for partnership information.
     * @path /partnerships/{partnershipId}
     * @allow (get) Any user can read partnership information.
     * @allow (list) Any user can list partnerships.
     * @allow (create) Any signed-in user can create a partnership.
     * @allow (update) No one can update a partnership.
     * @allow (delete) No one can delete a partnership.
     * @deny (create) An unauthenticated user cannot create a partnership.
     * @principle Allows public read access to partnerships while requiring authentication for creation.
     */
    match /partnerships/{partnershipId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Security rules for key performance indicators.
     * @path /impact-metrics/{metricId}
     * @allow (get) Any user can read KPI metrics.
     * @allow (list) Any user can list metrics.
     * @allow (create) Any signed-in user can create a metric.
     * @allow (update) No one can update a metric.
     * @allow (delete) No one can delete a metric.
     * @deny (create) An unauthenticated user cannot create a metric.
     * @principle Allows public read access to metrics while requiring authentication for creation.
     */
    match /impact-metrics/{metricId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Security rules for projects and their associated metrics.
     * @path /projects/{projectId}
     * @allow (get) Any user can read project data.
     * @allow (list) Any user can list projects.
     * @allow (create) Any signed-in user can create a project.
     * @allow (update) No one can update a project.
     * @allow (delete) No one can delete a project.
     * @deny (create) An unauthenticated user cannot create a project.
     * @principle Allows public read access to projects while requiring authentication for creation.
     */
    match /projects/{projectId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Security rules for organizational calendar events.
     * @path /events/{eventId}
     * @allow (get) Any user can read calendar events.
     * @allow (list) Any user can list calendar events.
     * @allow (create) Any signed-in user can create an event.
     * @allow (update) No one can update a calendar event.
     * @allow (delete) No one can delete a calendar event.
     * @deny (create) An unauthenticated user cannot create a calendar event.
     * @principle Allows public read access to calendar events while requiring authentication for creation.
     */
    match /events/{eventId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Security rules for system-wide alerts and notifications.
     * @path /alerts/{alertId}
     * @allow (get) Any user can read alerts.
     * @allow (list) Any user can list alerts.
     * @allow (create) Any signed-in user can create an alert.
     * @allow (update) No one can update an alert.
     * @allow (delete) No one can delete an alert.
     * @deny (create) An unauthenticated user cannot create an alert.
     * @principle Allows public read access to alerts while requiring authentication for creation.
     */
    match /alerts/{alertId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Security rules for the key results for the October Operational Plan.
     * @path /key-results/{keyResultId}
     * @allow (get) Any user can read key results.
     * @allow (list) Any user can list key results.
     * @allow (create) Any signed-in user can create a key result.
     * @allow (update) No one can update a key result.
     * @allow (delete) No one can delete a key result.
     * @deny (create) An unauthenticated user cannot create a key result.
     * @principle Allows public read access to key results while requiring authentication for creation.
     */
    match /key-results/{keyResultId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Security rules for expense reports submitted by users.
     * @path /expenses/{expenseId}
     * @allow (get) Any user can read expense reports.
     * @allow (list) Any user can list expense reports.
     * @allow (create) Any signed-in user can create an expense report.
     * @allow (update) No one can update an expense report.
     * @allow (delete) No one can delete an expense report.
     * @deny (create) An unauthenticated user cannot create an expense report.
     */
    match /expenses/{expenseId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}