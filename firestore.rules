/**
 * @fileoverview Firestore Security Rules for Omuto Central.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and
 * activity logs. Other collections (programs, partnerships, checkouts) are
 * publicly readable but only modifiable by authenticated users. No specific roles are defined in the data model, but rules are structured for easy extensibility.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, accessible only to the
 *   owning user.
 * - /checkouts/{checkoutId}: Stores checkout data. Publicly readable, only
 *   creatable by authenticated users.
 * - /activities/{activityId}: Stores activity logs. Publicly readable, only
 *   creatable by authenticated users.
 * - /programs/{programId}: Stores program data. Publicly readable, only
 *   creatable by authenticated users.
 * - /partnerships/{partnershipId}: Stores partnership data. Publicly readable, only
 *   creatable by authenticated users.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Data schema is NOT validated in this prototyping phase.
 * - Ambiguous relationships default to strict owner-only access.
 *
 * Denormalization for Authorization:
 * - The rules rely on the `request.auth.uid` for identity verification.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user ID matches the authenticated user's ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user ID matches the authenticated user's ID and the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) User znBqhM6pR9hypuw86hFP00dtJFF2 can create their own profile.
     * @allow (get) User znBqhM6pR9hypuw86hFP00dtJFF2 can read their own profile.
     * @allow (update) User znBqhM6pR9hypuw86hFP00dtJFF2 can update their own profile.
     * @allow (delete) User znBqhM6pR9hypuw86hFP00dtJFF2 can delete their own profile.
     * @deny (create) User abc cannot create profile for user def.
     * @deny (get) User abc cannot read profile for user def.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for checkouts.
     * @path /checkouts/{checkoutId}
     * @allow (create) User znBqhM6pR9hypuw86hFP00dtJFF2 can create a checkout.
     * @allow (get) Any user can read a checkout.
     * @allow (list) Any user can list checkouts.
     * @deny (update) User znBqhM6pR9hypuw86hFP00dtJFF2 cannot update a checkout.
     * @deny (delete) User znBqhM6pR9hypuw86hFP00dtJFF2 cannot delete a checkout.
     * @principle Allows public read access, restricts writes to authenticated users.
     */
    match /checkouts/{checkoutId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for activities.
     * @path /activities/{activityId}
     * @allow (create) User znBqhM6pR9hypuw86hFP00dtJFF2 can create an activity.
     * @allow (get) Any user can read an activity.
     * @allow (list) Any user can list activities.
     * @deny (update) User znBqhM6pR9hypuw86hFP00dtJFF2 cannot update an activity.
     * @deny (delete) User znBqhM6pR9hypuw86hFP00dtJFF2 cannot delete an activity.
     * @principle Allows public read access, restricts writes to authenticated users.
     */
    match /activities/{activityId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for programs.
     * @path /programs/{programId}
     * @allow (create) User znBqhM6pR9hypuw86hFP00dtJFF2 can create a program.
     * @allow (get) Any user can read a program.
     * @allow (list) Any user can list programs.
     * @deny (update) User znBqhM6pR9hypuw86hFP00dtJFF2 cannot update a program.
     * @deny (delete) User znBqhM6pR9hypuw86hFP00dtJFF2 cannot delete a program.
     * @principle Allows public read access, restricts writes to authenticated users.
     */
    match /programs/{programId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rules for partnerships.
     * @path /partnerships/{partnershipId}
     * @allow (create) User znBqhM6pR9hypuw86hFP00dtJFF2 can create a partnership.
     * @allow (get) Any user can read a partnership.
     * @allow (list) Any user can list partnerships.
     * @deny (update) User znBqhM6pR9hypuw86hFP00dtJFF2 cannot update a partnership.
     * @deny (delete) User znBqhM6pR9hypuw86hFP00dtJFF2 cannot delete a partnership.
     * @principle Allows public read access, restricts writes to authenticated users.
     */
    match /partnerships/{partnershipId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}