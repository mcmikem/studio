/**
 * @file Omuto Central Firestore Security Rules
 * @core_philosophy This ruleset prioritizes rapid prototyping by relaxing data shape validation
 * while enforcing authentication and authorization.
 * @data_structure Top-level collections store various entities like users, programs, activities,
 * and more.  User-specific data is nested under /users/{userId}.
 * @key_security_decisions Listing of users is disallowed. Most collections default to owner-only
 * write access unless explicitly made public.  Schema validation is minimal to allow for flexible
 * data changes during prototyping.
 * @denormalization None explicitly used.
 * @structural_segregation No explicit segregation.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read/write access to user profile information for the owner.
     * @path /users/{userId}
     * @allow (create, update, delete) - User with ID 'user123' can create/update/delete their own profile at /users/user123.
     * @allow (get, list) - Any authenticated user can read the user profile
     * @deny (create, update, delete) - User with ID 'user456' cannot create/update/delete the profile at /users/user123.
     * @principle Enforces document ownership for writes and public read access.
     */
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId && resource != null;
      allow delete: if request.auth != null && request.auth.uid == userId && resource != null;
    }

    /**
     * @description Allows read/write access to tasks for a specific user.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create, update, delete) - User with ID 'user123' can create/update/delete tasks under their profile.
     * @allow (list, get) - User with ID 'user123' can list and get tasks under their profile.
     * @deny (create, update, delete) - User with ID 'user456' cannot create/update/delete tasks under /users/user123.
     * @principle Restricts access to a user's own task list.
     */
    match /users/{userId}/tasks/{taskId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId && resource != null;
      allow delete: if request.auth != null && request.auth.uid == userId && resource != null;
    }

    /**
     * @description Allows read/write access to daily check-in plans for team members.
     * @path /checkins/{checkinId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any checkin
     * @allow (get, list) - Any authenticated user can read any checkin
     * @principle Allows any authenticated user to create, read, update, and delete checkins.
     */
    match /checkins/{checkinId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to daily checkout updates for team members.
     * @path /checkouts/{checkoutId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any checkout
     * @allow (get, list) - Any authenticated user can read any checkout
     * @principle Allows any authenticated user to create, read, update, and delete checkouts.
     */
    match /checkouts/{checkoutId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to logged activities from the ROI Calculator.
     * @path /activities/{activityId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any activity
     * @allow (get, list) - Any authenticated user can read any activity
     * @principle Allows any authenticated user to create, read, update, and delete activities.
     */
    match /activities/{activityId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to Omuto's core programs and initiatives.
     * @path /programs/{programId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any program
     * @allow (get, list) - Any authenticated user can read any program
     * @principle Allows any authenticated user to create, read, update, and delete programs.
     */
    match /programs/{programId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to information about partner organizations.
     * @path /partnerships/{partnershipId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any partnership
     * @allow (get, list) - Any authenticated user can read any partnership
     * @principle Allows any authenticated user to create, read, update, and delete partnerships.
     */
    match /partnerships/{partnershipId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to key performance indicators (KPIs) for the organization.
     * @path /impact-metrics/{metricId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any impact metric
     * @allow (get, list) - Any authenticated user can read any impact metric
     * @principle Allows any authenticated user to create, read, update, and delete impact metrics.
     */
    match /impact-metrics/{metricId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to high-level projects and their associated metrics.
     * @path /projects/{projectId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any project
     * @allow (get, list) - Any authenticated user can read any project
     * @principle Allows any authenticated user to create, read, update, and delete projects.
     */
    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to organizational calendar events.
     * @path /events/{eventId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any event
     * @allow (get, list) - Any authenticated user can read any event
     * @principle Allows any authenticated user to create, read, update, and delete events.
     */
    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to system-wide alerts and notifications.
     * @path /alerts/{alertId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any alert
     * @allow (get, list) - Any authenticated user can read any alert
     * @principle Allows any authenticated user to create, read, update, and delete alerts.
     */
    match /alerts/{alertId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to the key results for the October Operational Plan.
     * @path /key-results/{keyResultId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any key result
     * @allow (get, list) - Any authenticated user can read any key result
     * @principle Allows any authenticated user to create, read, update, and delete key results.
     */
    match /key-results/{keyResultId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to expense reports submitted by users.
     * @path /expenses/{expenseId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any expense
     * @allow (get, list) - Any authenticated user can read any expense
     * @principle Allows any authenticated user to create, read, update, and delete expenses.
     */
    match /expenses/{expenseId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to all income and revenue transactions.
     * @path /income/{incomeId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any income
     * @allow (get, list) - Any authenticated user can read any income
     * @principle Allows any authenticated user to create, read, update, and delete income.
     */
    match /income/{incomeId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to grant proposals and funding applications.
     * @path /proposals/{proposalId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any proposal
     * @allow (get, list) - Any authenticated user can read any proposal
     * @principle Allows any authenticated user to create, read, update, and delete proposals.
     */
    match /proposals/{proposalId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to manager-created team-wide weekly plans.
     * @path /team-workplans/{teamWorkplanId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any team workplan
     * @allow (get, list) - Any authenticated user can read any team workplan
     * @principle Allows any authenticated user to create, read, update, and delete team workplans.
     */
    match /team-workplans/{teamWorkplanId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to individuals' finalized weekly workplans.
     * @path /workplans/{workplanId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any workplan
     * @allow (get, list) - Any authenticated user can read any workplan
     * @principle Allows any authenticated user to create, read, update, and delete workplans.
     */
    match /workplans/{workplanId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to the inventory of physical equipment.
     * @path /equipment/{equipmentId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any equipment
     * @allow (get, list) - Any authenticated user can read any equipment
     * @principle Allows any authenticated user to create, read, update, and delete equipment.
     */
    match /equipment/{equipmentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to reusable task templates and checklists.
     * @path /task-templates/{templateId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any task template
     * @allow (get, list) - Any authenticated user can read any task template
     * @principle Allows any authenticated user to create, read, update, and delete task templates.
     */
    match /task-templates/{templateId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to team chat messages.
     * @path /messages/{messageId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any message
     * @allow (get, list) - Any authenticated user can read any message
     * @principle Allows any authenticated user to create, read, update, and delete messages.
     */
    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

     /**
     * @description Allows read/write access to recorded audio, video, or text testimonies.
     * @path /testimonies/{testimonyId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any testimony
     * @allow (get, list) - Any authenticated user can read any testimony
     * @principle Allows any authenticated user to create, read, update, and delete testimonies.
     */
    match /testimonies/{testimonyId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }

    /**
     * @description Allows read/write access to user feedback on AI-generated content.
     * @path /ai-feedback/{feedbackId}
     * @allow (create, update, delete) - Any authenticated user can create/update/delete any AI Feedback
     * @allow (get, list) - Any authenticated user can read any AI Feedback
     * @principle Allows any authenticated user to create, read, update, and delete AI Feedback.
     */
    match /ai-feedback/{feedbackId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource != null;
      allow delete: if request.auth != null && resource != null;
    }
  }
}