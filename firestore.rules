rules_version = '2';

service cloud.firestore {
  // Helper function to get user role from users collection
  function getUserRole() {
    return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
  }
  
  function isExecutiveDirector() {
    return getUserRole() == 'Executive Director';
  }
  
  function isAdministrator() {
    return getUserRole() == 'Administrator';
  }
  
  function isAdminOrExecutive() {
    return isExecutiveDirector() || isAdministrator();
  }
  
  function isStaff() {
    let role = getUserRole();
    return role in ['Executive Director', 'Administrator', 'Programs & Partnerships Manager', 
                    'Operations & Field Manager', 'Media & Finance Lead', 
                    'Media & Communications Lead', 'Resource Mobilization Lead',
                    'Essentials Manager', 'Youth Center Manager', 'Accountant/Finance', 'Intern'];
  }
  
  function isVolunteer() {
    return getUserRole() == 'Volunteer';
  }

  // Users collection - users can read all, write own profile
  match /users/{userId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && request.auth.uid == userId;
    
    // User's subcollections
    match /tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }

  // Programs - readable by all, writable by staff
  match /programs/{programId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Projects - readable by all, writable by staff
  match /projects/{projectId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Expenses - readable by all authenticated, writable by staff
  match /expenses/{expenseId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Activities - readable by all, writable by authenticated users
  match /activities/{activityId} {
    allow read: if request.auth != null;
    allow create: if request.auth != null;
    allow update, delete: if request.auth != null && isStaff();
  }

  // Check-ins and Check-outs - readable by all, writable by authenticated users
  match /checkins/{checkinId} {
    allow read: if request.auth != null;
    allow create: if request.auth != null;
    allow update, delete: if request.auth != null;
  }
  
  match /checkouts/{checkoutId} {
    allow read: if request.auth != null;
    allow create: if request.auth != null;
    allow update, delete: if request.auth != null;
  }

  // Testimonies - readable by all, writable by authenticated users
  match /testimonies/{testimonyId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null;
  }

  // Beneficiaries - readable by all, writable by staff
  match /beneficiaries/{beneficiaryId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Partnerships - readable by all, writable by staff
  match /partnerships/{partnershipId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Key Results - readable by all, writable by admin/executive
  match /key-results/{keyResultId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isAdminOrExecutive();
  }

  // Alerts - readable by all, writable by staff
  match /alerts/{alertId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Events - readable by all, writable by staff
  match /events/{eventId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Finance - readable by staff, writable by admin/executive
  match /finance/{financeId} {
    allow read: if request.auth != null && isStaff();
    allow write: if request.auth != null && isAdminOrExecutive();
  }

  // Resources - readable by all authenticated
  match /resources/{resourceId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Essentials - Products, Sales, Inventory (readable by all, writable by staff)
  match /products/{productId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /product-categories/{categoryId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /sales/{saleId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /inventory/{inventoryId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /production-batches/{batchId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /customer-feedback/{feedbackId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Youth Center
  match /youth-center-students/{studentId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /youth-center-courses/{courseId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /youth-center-design-projects/{projectId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // OFA (football)
  match /ofa-teams/{teamId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /ofa-players/{playerId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // SLF (School Led Financing)
  match /slf-schools/{schoolId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Red Campaign
  match /pads-distributions/{distributionId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // YOSkills
  match /yoskills-youth/{youthId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /yoskills-sessions/{sessionId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /yoskills-ideas/{ideaId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /yoskills-circles/{circleId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // YAP
  match /yap-chapters/{chapterId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /yap-seed-grants/{grantId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // System
  match /system-feedback/{feedbackId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null;
  }
  
  match /bugs/{bugId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null;
  }

  // Dynamic Forms
  match /dynamic-forms/{formId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /dynamic-form-submissions/{submissionId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null;
  }

  // AI Knowledge
  match /ai-knowledge-sources/{sourceId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Printing Jobs
  match /printing-jobs/{jobId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // YOSkills Additional
  match /pitch-scores/{scoreId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /business-progress/{progressId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // YAP Additional
  match /yap-reports/{reportId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /seed-grant-applications/{applicationId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /seed-grant-accountability/{accountabilityId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // School Applications
  match /school-applications/{applicationId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Red Campaign Additional
  match /school-visits/{visitId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /mhm-trainings/{trainingId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // PureWater
  match /water-sources/{sourceId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /wash-assessments/{assessmentId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Pulse
  match /pulse-content/{contentId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // OFA Additional
  match /ofa-volunteers/{volunteerId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /omuto-cup-tournaments/{tournamentId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /ofa-quarterly-scorecards/{scorecardId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /ofa-match-summaries/{summaryId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /ofa-matches/{matchId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /ofa-equipment-impact/{impactId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /ofa-advanced-analysis/{analysisId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Green Schools
  match /waste-audits/{auditId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /tree-surveys/{surveyId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /baseline-surveys/{surveyId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /endline-surveys/{surveyId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /attendance-records/{recordId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null;
  }
  
  match /environmental-clubs/{clubId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Events & Comments
  match /events/{eventId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null;
  }
  
  match /comments/{commentId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null;
  }

  // Finance Additional
  match /income/{incomeId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /proposals/{proposalId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /resources/{resourceId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /equipment/{equipmentId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Health Checks & Meetings
  match /partnerships/{partnershipId}/health-checks/{checkId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }
  
  match /partnerships/{partnershipId}/meetings/{meetingId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // SLF Additional
  match /prefect-performance/{performanceId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Programs data subcollections
  match /programs/{programId}/data/{dataId} {
    allow read: if request.auth != null;
    allow write: if request.auth != null && isStaff();
  }

  // Default rule - require authentication
  match /{document=**} {
    allow read, write: if request.auth != null;
  }
}
