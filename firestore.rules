/**
 * @fileoverview Firestore Security Rules for Omuto Central.
 *
 * Core Philosophy:
 * For this stage of development, these rules enforce that a user must be
 * authenticated to read or write any data. This provides a secure baseline
 * while allowing all internal application features to function.
 *
 * Future Enhancements:
 * More granular, role-based access control can be added later. For example,
 * restricting 'update' on '/programs/{programId}' to users with a 'Manager' role.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for authentication
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Users can manage their own profile and read other user profiles.
     * The `list` permission is required for features like the Team Directory.
     */
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Users can manage their own tasks.
     */
    match /users/{userId}/tasks/{taskId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Authenticated users can read all check-ins and create their own.
     */
    match /checkins/{checkinId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Updates and deletes are disallowed for now to maintain a clear audit trail.
      allow update, delete: if false;
    }

    /**
     * @description Authenticated users can read all check-outs and create their own.
     */
    match /checkouts/{checkoutId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Updates and deletes are disallowed for now to maintain a clear audit trail.
      allow update, delete: if false;
    }

    /**
     * @description Generic rule for organization-wide data.
     * Any authenticated user can read, create, update, or delete records in these
     * collections. This is necessary for the management pages to function.
     */
    match /{collection}/{docId}
      where collection in [
        'activities',
        'programs',
        'partnerships',
        'impact-metrics',
        'projects',
        'events',
        'alerts',
        'key-results',
        'expenses'
      ] {
      allow read, write: if isSignedIn();
    }
  }
}
