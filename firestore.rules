rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile information.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     * @allow (get, update, delete) User with ID 'user123' can read and modify their own profile.
     * @deny (create) User with ID 'user456' cannot create a profile with ID 'user123'.
     * @deny (get, update, delete) User with ID 'user456' cannot read or modify user 'user123's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Manages tasks for a specific user.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) User with ID 'user123' can create a task under their profile.
     * @allow (get, list, update, delete) User with ID 'user123' can read, list, and modify their own tasks.
     * @deny (create) User with ID 'user456' cannot create a task under user 'user123's profile.
     * @deny (get, list, update, delete) User with ID 'user456' cannot read, list, or modify user 'user123's tasks.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/tasks/{taskId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Stores daily check-in plans from team members.
     * @path /checkins/{checkinId}
     * @allow (create) Authenticated user can create a check-in.
     * @allow (get, list, update, delete) Authenticated user can read, list and modify own checkin.
     * @deny (create) Unauthenticated user cannot create a check-in.
     * @principle Authenticated users can create and manage their check-ins.
     */
    match /checkins/{checkinId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    /**
     * @description Stores daily checkout updates from team members.
     * @path /checkouts/{checkoutId}
     * @allow (create) Authenticated user can create a checkout.
     * @allow (get, list, update, delete) Authenticated user can read, list, and modify their own checkout.
     * @deny (create) Unauthenticated user cannot create a checkout.
     * @principle Authenticated users can create and manage their checkouts.
     */
    match /checkouts/{checkoutId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    /**
     * @description Stores logged activities from the ROI Calculator.
     * @path /activities/{activityId}
     * @allow (create) Authenticated user can create an activity.
     * @allow (get, list, update, delete) Authenticated user can read, list, and modify own activity.
     * @deny (create) Unauthenticated user cannot create an activity.
     * @principle Authenticated users can create and manage their activities.
     */
    match /activities/{activityId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    /**
     * @description Stores Omuto's core programs and initiatives.
     * @path /programs/{programId}
     * @allow (get, list) Anyone can read program information.
     * @deny (create, update, delete) No one can create, update, or delete program information without proper authorization.
     * @principle Publicly readable, owner-only writes (requires 'ownerId' or similar field).
     */
    match /programs/{programId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores information about partner organizations.
     * @path /partnerships/{partnershipId}
     * @allow (get, list) Anyone can read partnership information.
     * @deny (create, update, delete) No one can create, update, or delete partnership information without proper authorization.
     * @principle Publicly readable, owner-only writes (requires 'ownerId' or similar field).
     */
    match /partnerships/{partnershipId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores key performance indicators (KPIs) for the organization.
     * @path /impact-metrics/{metricId}
     * @allow (get, list) Anyone can read impact metrics.
     * @deny (create, update, delete) No one can create, update, or delete impact metrics without proper authorization.
     * @principle Publicly readable, owner-only writes (requires 'ownerId' or similar field).
     */
    match /impact-metrics/{metricId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores high-level projects and their associated metrics.
     * @path /projects/{projectId}
     * @allow (get, list) Anyone can read project information.
     * @deny (create, update, delete) No one can create, update, or delete project information without proper authorization.
     * @principle Publicly readable, owner-only writes (requires 'ownerId' or similar field).
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores organizational calendar events.
     * @path /events/{eventId}
     * @allow (get, list) Anyone can read calendar events.
     * @deny (create, update, delete) No one can create, update, or delete calendar events without proper authorization.
     * @principle Publicly readable, owner-only writes (requires 'ownerId' or similar field).
     */
    match /events/{eventId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores system-wide alerts and notifications.
     * @path /alerts/{alertId}
     * @allow (create) Authenticated user can create a alert.
     * @allow (get, list, update, delete) Authenticated user can read, list, and modify own alert.
     * @deny (create) Unauthenticated user cannot create an alert.
     * @principle Authenticated users can create and manage their alerts.
     */
    match /alerts/{alertId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    /**
     * @description Stores the key results for the October Operational Plan.
     * @path /key-results/{keyResultId}
     * @allow (get, list) Anyone can read key results.
     * @deny (create, update, delete) No one can create, update, or delete key results without proper authorization.
     * @principle Publicly readable, owner-only writes (requires 'ownerId' or similar field).
     */
    match /key-results/{keyResultId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores expense reports submitted by users.
     * @path /expenses/{expenseId}
     * @allow (create) Authenticated user can create a expense.
     * @allow (get, list, update, delete) Authenticated user can read, list, and modify own expense.
     * @deny (create) Unauthenticated user cannot create an expense.
     * @principle Authenticated users can create and manage their expenses.
     */
    match /expenses/{expenseId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    /**
     * @description Stores all income and revenue transactions.
     * @path /income/{incomeId}
     * @allow (get, list) Anyone can read income records.
     * @deny (create, update, delete) No one can create, update, or delete income records without proper authorization.
     * @principle Publicly readable, owner-only writes.
     */
    match /income/{incomeId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores grant proposals and funding applications.
     * @path /proposals/{proposalId}
     * @allow (get, list) Anyone can read proposals.
     * @deny (create, update, delete) No one can create, update, or delete proposals without proper authorization.
     * @principle Publicly readable, owner-only writes.
     */
    match /proposals/{proposalId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores manager-created team-wide weekly plans.
     * @path /team-workplans/{teamWorkplanId}
     * @allow (get, list) Anyone can read team workplans.
     * @deny (create, update, delete) No one can create, update, or delete team workplans without proper authorization.
     * @principle Publicly readable, owner-only writes.
     */
    match /team-workplans/{teamWorkplanId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores individuals' finalized weekly workplans.
     * @path /workplans/{workplanId}
     * @allow (create) Authenticated user can create a workplan.
     * @allow (get, list, update, delete) Authenticated user can read, list, and modify own workplan.
     * @deny (create) Unauthenticated user cannot create a workplan.
     * @principle Authenticated users can create and manage their workplans.
     */
    match /workplans/{workplanId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    /**
     * @description Stores the inventory of physical equipment.
     * @path /equipment/{equipmentId}
     * @allow (get, list) Anyone can read equipment information.
     * @deny (create, update, delete) No one can create, update, or delete equipment information without proper authorization.
     * @principle Publicly readable, owner-only writes.
     */
    match /equipment/{equipmentId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores reusable task templates and checklists.
     * @path /task-templates/{templateId}
     * @allow (get, list) Anyone can read task templates.
     * @deny (create, update, delete) No one can create, update, or delete task templates without proper authorization.
     * @principle Publicly readable, owner-only writes.
     */
    match /task-templates/{templateId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores team chat messages.
     * @path /messages/{messageId}
     * @allow (create) Authenticated user can create a message.
     * @allow (get, list, update, delete) Authenticated user can read, list, and modify own message.
     * @deny (create) Unauthenticated user cannot create a message.
     * @principle Authenticated users can create and manage their messages.
     */
    match /messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    /**
     * @description Stores recorded audio, video, or text testimonies.
     * @path /testimonies/{testimonyId}
     * @allow (get, list) Anyone can read testimonies.
     * @deny (create, update, delete) No one can create, update, or delete testimonies without proper authorization.
     * @principle Publicly readable, owner-only writes.
     */
    match /testimonies/{testimonyId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Stores user feedback on AI-generated content.
     * @path /ai-feedback/{feedbackId}
     * @allow (create) Authenticated user can create a AI feedback.
     * @allow (get, list, update, delete) Authenticated user can read, list, and modify own AI feedback.
     * @deny (create) Unauthenticated user cannot create an AI feedback.
     * @principle Authenticated users can create and manage their ai-feedbacks.
     */
    match /ai-feedback/{feedbackId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
  }
}