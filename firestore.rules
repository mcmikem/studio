/**
 * @fileoverview Firestore Security Rules for Omuto Central.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and tasks,
 * while allowing public read access to other collections like check-ins, checkouts,
 * activities, and various organizational data points (programs, partnerships, etc.).
 * Write access to these public-read collections is restricted to authenticated users.
 *
 * Data Structure:
 * - User profiles and tasks are nested under /users/{userId}.
 * - All other data (check-ins, activities, etc.) resides in top-level collections.
 *
 * Key Security Decisions:
 * - User listing is disabled to prevent unauthorized enumeration of user accounts.
 * - Public read access is granted to several collections to facilitate data sharing and reporting.
 * - Write operations on public-read collections are restricted to authenticated users, but a CRITICAL TODO is included to add owner-only validation by adding ownerId/authorId field.
 *
 * Denormalization for Authorization:
 * The rules rely on the `request.auth.uid` for identity verification.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource.data != null;
    }

    /**
     * @description Enforces owner-only access to user profile data.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' creates their profile.
     * @deny (create) User with ID 'user123' attempts to create profile for 'otherUser'.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // User listing is disabled.

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Enforces owner-only access to user tasks.
     * @path /users/{userId}/tasks/{taskId}
     * @allow (create) User with ID 'user123' creates a task.
     * @deny (create) User with ID 'user123' attempts to create a task for 'otherUser'.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to check-in documents, but restricts write access to authenticated users.
     * @path /checkins/{checkinId}
     * @allow (get) Any user can retrieve a check-in.
     * @allow (list) Any user can list check-ins.
     * @allow (create) Any authenticated user can create a check-in.
     * @deny (create) Unauthenticated user attempts to create a check-in.
     * @principle Allows public read access while restricting writes to authenticated users.
     */
    match /checkins/{checkinId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null; // CRITICAL: Cannot implement owner-only writes. The 'Checkin' entity is missing an 'ownerId' or 'authorId' field.
    }

     /**
     * @description Allows public read access to checkout documents, but restricts write access to authenticated users.
     * @path /checkouts/{checkoutId}
     * @allow (get) Any user can retrieve a checkout.
     * @allow (list) Any user can list checkouts.
     * @allow (create) Any authenticated user can create a checkout.
     * @deny (create) Unauthenticated user attempts to create a checkout.
     * @principle Allows public read access while restricting writes to authenticated users.
     */
    match /checkouts/{checkoutId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null; // CRITICAL: Cannot implement owner-only writes. The 'Checkout' entity is missing an 'ownerId' or 'authorId' field.
    }

    /**
     * @description Allows public read access to activity documents, but restricts write access to authenticated users.
     * @path /activities/{activityId}
     * @allow (get) Any user can retrieve an activity.
     * @allow (list) Any user can list activities.
     * @allow (create) Any authenticated user can create an activity.
     * @deny (create) Unauthenticated user attempts to create an activity.
     * @principle Allows public read access while restricting writes to authenticated users.
     */
    match /activities/{activityId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null; // CRITICAL: Cannot implement owner-only writes. The 'Activity' entity is missing an 'ownerId' or 'authorId' field.
    }

