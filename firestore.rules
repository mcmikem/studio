/**
 * @file Omuto Central Firestore Security Rules
 * @core_philosophy This ruleset enforces role-based access control (RBAC) and document ownership.
 * It prioritizes security and data integrity over the initial open-prototyping rules.
 * @data_structure Top-level collections store various entities. User-specific data is nested under /users/{userId}.
 * @key_security_decisions
 *   - User profiles are only writable by their owner.
 *   - Management collections (programs, projects, etc.) are only writable by users with management roles.
 *   - Financial data (expenses) has strict read/write access controls based on ownership and finance roles.
 *   - Most collections are world-readable for authenticated users to power dashboards, but writes are restricted.
 */
rules_version = '2';

function isManager(userId) {
  let userRole = get(/databases/$(database)/documents/users/$(userId)).data.role;
  return userRole in ['Executive Director', 'Programs & Partnerships Manager', 'Operations & Field Manager', 'Media & Finance Lead', 'Media & Communications Lead', 'Administrator', 'Resource Mobilization Lead'];
}

function isFinance(userId) {
  let userRole = get(/databases/$(database)/documents/users/$(userId)).data.role;
  return userRole in ['Executive Director', 'Media & Finance Lead', 'Media & Communications Lead', 'Administrator'];
}

function isOwner(userId) {
  return request.auth.uid == userId;
}

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description User profiles. A user can only write to their own profile. Anyone can read.
     */
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }

    /**
     * @description User-specific sub-collections (tasks, ai-chats). Only the owner can access.
     */
    match /users/{userId}/{subcollection}/{docId} {
      allow read, write: if isOwner(userId);
    }

    /**
     * @description Public read, but restricted writes to managers for core operational data.
     */
    match /programs/{programId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }
    match /partnerships/{partnershipId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }
     match /partnerships/{partnershipId}/{subcollection}/{docId} {
      allow read, write: if isManager(request.auth.uid);
    }
    match /impact-metrics/{metricId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }
    match /equipment/{equipmentId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }
     match /task-templates/{templateId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }

    /**
     * @description Team-wide communication streams. Anyone can read, but only the owner can create/modify their own entries.
     */
    match /checkins/{checkinId} {
        allow read: if request.auth != null;
        allow write: if request.auth.uid == request.resource.data.userId;
    }
    match /checkouts/{checkoutId} {
        allow read: if request.auth != null;
        allow write: if request.auth.uid == request.resource.data.userId;
    }
     match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth.uid == request.resource.data.userId;
        allow update, delete: if request.auth.uid == resource.data.userId;
    }
    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }
    match /workplans/{workplanId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }
     match /testimonies/{testimonyId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }
    match /ai-feedback/{feedbackId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }


    /**
     * @description Team-wide plans are readable by all, but only writable by managers.
     */
    match /team-workplans/{planId} {
        allow read: if request.auth != null;
        allow write: if isManager(request.auth.uid);
    }


    /**
     * @description Alerts are readable if they are broadcast (targetUserIds is empty) or if the user is in the target list.
     * Only managers can create alerts.
     */
    match /alerts/{alertId} {
      allow read: if request.auth != null && (resource.data.targetUserIds.size() == 0 || request.auth.uid in resource.data.targetUserIds);
      allow write: if isManager(request.auth.uid);
    }

    /**
     * @description Financial data has the strictest rules.
     */
    match /expenses/{expenseId} {
      allow get: if request.auth != null && (isFinance(request.auth.uid) || resource.data.userId == request.auth.uid);
      allow list: if request.auth != null && isFinance(request.auth.uid);
      allow create: if request.auth != null; // Anyone can create, but logic should set userId to their own uid
      allow update: if request.auth != null && isManager(request.auth.uid); // Only managers can approve/reject
      allow delete: if request.auth != null && (isFinance(request.auth.uid) || resource.data.userId == request.auth.uid);
    }

    match /income/{incomeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isFinance(request.auth.uid);
    }
    
    match /proposals/{proposalId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isManager(request.auth.uid);
    }
    
    // Default deny for any collections not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
