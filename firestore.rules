
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to check user roles.
    function isManager(userId) {
      let userRole = get(/databases/$(database)/documents/users/$(userId)).data.role;
      return userRole in ['Executive Director', 'Programs & Partnerships Manager', 'Operations & Field Manager', 'Media & Finance Lead', 'Media & Communications Lead', 'Administrator', 'Resource Mobilization Lead'];
    }

    function isFinance(userId) {
      let userRole = get(/databases/$(database)/documents/users/$(userId)).data.role;
      return userRole in ['Executive Director', 'Media & Finance Lead', 'Media & Communications Lead', 'Administrator'];
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // USER PROFILES
    // Users can only write to their own profile. Anyone authenticated can read profiles.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }

    // USER SUB-COLLECTIONS
    // A user's private data (tasks, AI chats) is only accessible by them.
    match /users/{userId}/{subcollection}/{docId} {
      allow read, write: if isOwner(userId);
    }

    // MANAGEMENT COLLECTIONS (Programs, Projects, Partnerships, etc.)
    // Anyone authenticated can read these for dashboards, but only managers can write.
    match /programs/{programId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }
    match /partnerships/{partnershipId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }
     match /partnerships/{partnershipId}/{subcollection}/{docId} {
      allow read, write: if isManager(request.auth.uid);
    }
    match /impact-metrics/{metricId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }
    match /equipment/{equipmentId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }
     match /task-templates/{templateId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }
     match /key-results/{keyResultId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }

    // TEAM-WIDE USER-GENERATED CONTENT (Check-ins, Check-outs, Messages, etc.)
    // Anyone authenticated can read. Create/update/delete is restricted to the owner.
    match /checkins/{checkinId} {
        allow read: if request.auth != null;
        // Allow create if the user ID in the new document matches the requester's ID.
        allow create: if request.auth.uid == request.resource.data.userId;
        // Allow update/delete if the user ID in the existing document matches the requester's ID.
        allow update, delete: if request.auth.uid == resource.data.userId;
    }
    match /checkouts/{checkoutId} {
        allow read: if request.auth != null;
        allow create: if request.auth.uid == request.resource.data.userId;
        allow update, delete: if request.auth.uid == resource.data.userId;
    }
     match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth.uid == request.resource.data.userId;
        allow update, delete: if request.auth.uid == resource.data.userId;
    }
    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }
    match /workplans/{workplanId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }
     match /testimonies/{testimonyId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }
    match /ai-feedback/{feedbackId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if false; // Feedback is write-once
    }
    match /events/{eventId} {
        allow read: if request.auth != null;
        allow write: if isManager(request.auth.uid);
    }


    // TEAM-WIDE PLANS (Writable by Managers)
    match /team-workplans/{planId} {
        allow read: if request.auth != null;
        allow write: if isManager(request.auth.uid);
    }


    // ALERTS
    // Readable by all if it's a broadcast, or if the user is in the target list. Writable only by managers.
    match /alerts/{alertId} {
      allow read: if request.auth != null && (resource.data.targetUserIds.size() == 0 || request.auth.uid in resource.data.targetUserIds);
      allow write: if isManager(request.auth.uid);
    }

    // FINANCIALS (Strictest Rules)
    match /expenses/{expenseId} {
      // An owner can get their own report. Finance/ED can get any report.
      allow get: if request.auth != null && (isFinance(request.auth.uid) || resource.data.userId == request.auth.uid);
      // Only finance/ED can list all expenses for the main table view.
      allow list: if request.auth != null && isFinance(request.auth.uid);
      // Any authenticated user can create an expense report.
      allow create: if request.auth != null;
      // Only managers can approve/reject/disburse. Owners can acknowledge.
      allow update: if request.auth != null && (isManager(request.auth.uid) || (request.resource.data.status == 'Acknowledged' && resource.data.userId == request.auth.uid));
      // Owner or finance can delete.
      allow delete: if request.auth != null && (isFinance(request.auth.uid) || resource.data.userId == request.auth.uid);
    }

    match /income/{incomeId} {
      // Anyone can read income records. Only finance can write.
      allow read: if request.auth != null;
      allow write: if request.auth != null && isFinance(request.auth.uid);
    }
    
    match /proposals/{proposalId} {
      // Anyone can read proposals. Only managers can write.
      allow read: if request.auth != null;
      allow write: if request.auth != null && isManager(request.auth.uid);
    }
  }
}
