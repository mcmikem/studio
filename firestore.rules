     * @deny (create) Unauthenticated user attempts to create an activity.
     * @principle Allows public read access while restricting writes to authenticated users.
     */
    match /activities/{activityId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;

