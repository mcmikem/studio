/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @description This ruleset enforces a strict user-ownership model for user-specific data
 * and allows public read access for certain top-level collections while restricting writes to authorized users.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles. Only the authenticated user can read/write their own profile.
 * - /users/{userId}/tasks/{taskId}: Stores tasks for each user. Only the authenticated user can read/write their own tasks.
 * - /checkins/{checkinId}: Stores daily check-ins. Anyone can read. Only owner can write.
 * - /checkouts/{checkoutId}: Stores daily checkouts.  Anyone can read checkouts. Only the user who owns the record can create, update, or delete it.
 * - /activities/{activityId}: Stores logged activities. Anyone can read logged activities. Only the user who owns the record can create, update, or delete it.
 * - /programs/{programId}: Stores core programs and initiatives. Anyone can read. Authenticated users can write.
 * - /partnerships/{partnershipId}: Stores partnership information. Anyone can read. Authenticated users can write.
 *
 * Key Security Decisions:
 * - User listing is explicitly denied.
 * - All write operations require user authentication.
 * - Public read access is granted to /checkouts, /activities, /programs, and /partnerships.
 * - Ownership is enforced via the userId field in relevant documents where applicable.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces ownership for user profiles and their subcollections.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // No one can list all users
      allow create, update: if isOwner(userId);
      allow delete: if isExistingOwner(userId);

      /**
       * @description Enforces ownership for tasks within a user's profile.
       * @path /users/{userId}/tasks
       */
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }
    }

    /**
     * @description Allows public read on check-ins, owner-only write.
     * @path /checkins/{checkinId}
     */
    match /checkins/{checkinId} {
      allow read: if true;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }


    /**
     * @description Allows public read access to checkouts, while restricting write access to the owner.
     * @path /checkouts/{checkoutId}
     */
    match /checkouts/{checkoutId} {
        allow read: if true;
        allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    /**
     * @description Allows public read access to activities, while restricting write access to the owner.
     * @path /activities/{activityId}
     */
    match /activities/{activityId} {
        allow read: if true;
        allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    /**
     * @description Allows public read access to programs, and write access for authenticated users.
     * @path /programs/{programId}
     */
    match /programs/{programId} {
        allow read: if true;
        allow write: if isSignedIn();
    }

    /**
     * @description Allows public read access to partnerships, and write access for authenticated users.
     * @path /partnerships/{partnershipId}
     */
    match /partnerships/{partnershipId} {
        allow read: if true;
        allow write: if isSignedIn();
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}
