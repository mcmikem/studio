
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users: Can only read/update their own profile. Anyone can create a user doc on signup.
    match /users/{userId} {
      allow read, update: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated();
    }

    // User-specific subcollections (like tasks)
    match /users/{userId}/{collection}/{docId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
    }

    // General Collections:
    // Allow any authenticated user to read.
    // Allow authenticated users to create new documents.
    // Only allow users to update/delete documents they created.
    match /{collection}/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Special case for collections that don't have a `userId` field but should be manageable.
    // These rules are more open and should be refined in a production environment.
    match /programs/{programId} {
        allow read, write: if isAuthenticated();
    }
     match /partnerships/{partnershipId} {
        allow read, write: if isAuthenticated();
    }
     match /projects/{projectId} {
        allow read, write: if isAuthenticated();
    }
     match /impact-metrics/{metricId} {
        allow read, write: if isAuthenticated();
    }
     match /events/{eventId} {
        allow read, write: if isAuthenticated();
    }
     match /key-results/{keyResultId} {
        allow read, write: if isAuthenticated();
    }

  }
}
