/**
 * @file Firebase Security Rules for Omuto Central Firestore database.
 *
 * @Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles,
 * allows public read access to checkouts, activities, programs, and partnerships,
 * while restricting write access to authenticated users with matching IDs.
 *
 * @Data Structure:
 * - /users/{userId}: Stores individual user profiles, accessible only to the owning user.
 * - /checkouts/{checkoutId}: Stores daily checkout updates. Public read, owner-only write.
 * - /activities/{activityId}: Stores logged activities. Public read, owner-only write.
 * - /programs/{programId}: Stores program information. Public read, owner-only write.
 * - /partnerships/{partnershipId}: Stores partnership details. Public read, owner-only write.
 *
 * @Key Security Decisions:
 * - User listing is disallowed for privacy.
 * - Read-only collections (e.g., for configuration data) are not present in this data model.
 * - All write operations require user authentication.
 *
 * @Denormalization for Authorization:
 * - Checkouts, activities, programs, and partnerships documents require a `userId` field
 *   to associate them with the user who created them, enabling owner-only write permissions.
 *   The `userId` value MUST match the `request.auth.uid` on `create`.
 *
 * @Structural Segregation:
 * - No structural segregation is applied in this data model. Public and private data are
 *   not separated into different collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description: Controls access to user profile information.
     * @path: /users/{userId}
     * @allow: User 'znBqhM6pR9hypuw86hFP00dtJFF2' (get) their own profile.
     * @deny: User 'randomUser' (get) User 'znBqhM6pR9hypuw86hFP00dtJFF2' profile.
     * @principle: Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // User listing is not permitted.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description: Controls access to daily checkout updates.
     * @path: /checkouts/{checkoutId}
     * @allow: Any user (get) any checkout.
     * @allow: User 'znBqhM6pR9hypuw86hFP00dtJFF2' (create) a new checkout with matching userId.
     * @deny: User 'randomUser' (create) a checkout with userId 'znBqhM6pR9hypuw86hFP00dtJFF2'.
     * @principle: Allows public read access, but restricts write access to the owner.
     */
    match /checkouts/{checkoutId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.userId);
      allow delete: if isExistingOwner(resource.data.userId);
    }

    /**
     * @description: Controls access to logged activities.
     * @path: /activities/{activityId}
     * @allow: Any user (get) any activity.
     * @allow: User 'znBqhM6pR9hypuw86hFP00dtJFF2' (create) a new activity with matching userId.
     * @deny: User 'randomUser' (create) an activity with userId 'znBqhM6pR9hypuw86hFP00dtJFF2'.
     * @principle: Allows public read access, but restricts write access to the owner.
     */
    match /activities/{activityId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.userId);
      allow delete: if isExistingOwner(resource.data.userId);
    }

    /**
     * @description: Controls access to program information.
     * @path: /programs/{programId}
     * @allow: Any user (get) any program.
     * @principle: Allows public read access, but restricts write access to the owner.
     */
    match /programs/{programId} {
        // CRITICAL: Cannot implement owner-only writes. The 'Program' entity is missing an 'ownerId' or 'authorId' field.
        allow get, list: if true;
        allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description: Controls access to partnership details.
     * @path: /partnerships/{partnershipId}
     * @allow: Any user (get) any partnership.
     * @principle: Allows public read access, but restricts write access to the owner.
     */
    match /partnerships/{partnershipId} {
        // CRITICAL: Cannot implement owner-only writes. The 'Partnership' entity is missing an 'ownerId' or 'authorId' field.
        allow get, list: if true;
        allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description: Controls access to checkins collection.
     * @path: /checkins
     * @allow: Any user (get) any checkins.
     * @principle: Allows public read access, but restricts write access to the owner.
     */
        match /checkins/{checkinId} {
            function isOwner(userId) {
                return request.auth.uid == userId;
            }

            function isExistingOwner(userId) {
                return isOwner(userId) && resource != null;
            }

            allow get: if true;
            allow list: if true;
            allow create: if request.resource.data.userId == request.auth.uid;
            allow update: if isExistingOwner(resource.data.userId);
            allow delete: if isExistingOwner(resource.data.userId);
    }
  }
}