/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and their associated data (tasks),
 * while allowing public read access to other collections such as programs, partnerships, and impact metrics.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, accessible only to the user themselves.
 * - /users/{userId}/tasks/{taskId}: Stores tasks specific to a user, accessible only to that user.
 * - /checkins/{checkinId}: Stores daily check-in plans, publicly readable but writeable by no one (TODO).
 * - /checkouts/{checkoutId}: Stores daily checkout updates, publicly readable but writeable by no one (TODO).
 * - /activities/{activityId}: Stores activity logs, publicly readable but writeable by no one (TODO).
 * - /programs/{programId}: Stores program information, publicly readable but writeable by no one (TODO).
 * - /partnerships/{partnershipId}: Stores partnership information, publicly readable but writeable by no one (TODO).
 * - /impact-metrics/{metricId}: Stores impact metrics, publicly readable but writeable by no one (TODO).
 * - /projects/{projectId}: Stores project information, publicly readable but writeable by no one (TODO).
 * - /events/{eventId}: Stores calendar events, publicly readable but writeable by no one (TODO).
 * - /alerts/{alertId}: Stores alerts, publicly readable but writeable by no one (TODO).
 * - /key-results/{keyResultId}: Stores key results, publicly readable but writeable by no one (TODO).
 * - /expenses/{expenseId}: Stores expense reports, publicly readable but writeable by no one (TODO).
 *
 * Key Security Decisions:
 * - User listing is explicitly denied.
 * - Public read access is granted to programs, partnerships, impact metrics, checkins, checkouts, activities, projects, events, alerts and key results.
 * - Default security posture for collections without clear ownership is read-only (public read, no writes).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles, allowing only the owner to read and write their own profile.
     * @path /users/{userId}
     * @allow (get, update, delete) User Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1 can access /users/Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1
     * @allow (create) User Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1 can create /users/Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1
     * @deny (get, update, delete) User Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1 cannot access /users/DifferentUserID
     * @deny (create) User Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1 cannot create /users/DifferentUserID
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      // Verified user can read their own profile.
      allow get: if isSignedIn() && isOwner(userId);
      // Verified user can create their own profile.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      // Verified user can update their own profile.
      allow update: if isSignedIn() && isOwner(userId) && resource.data.id == userId;
      // Verified user can delete their own profile.
      allow delete: if isSignedIn() && isOwner(userId) && resource != null;
      // User listing is explicitly denied.
      allow list: if false;
    }

     /**
      * @description Secure tasks under a user profile. Only the owner can manage their own tasks.
      * @path /users/{userId}/tasks/{taskId}
      * @allow (get, list, create, update, delete) User Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1 can access /users/Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1/tasks/{taskId}
      * @deny (get, list, create, update, delete) User Rj9VkZ5J1qcMQ71GpJqRDj9Ptii1 cannot access /users/DifferentUserID/tasks/{taskId}
      * @principle Enforces strict user ownership for task management.
      */
    match /users/{userId}/tasks/{taskId} {
      // Read permissions: only the owner can read tasks.
      allow get: if isSignedIn() && isOwner(userId);
      // List permission: only the owner can list their own tasks.
      allow list: if isSignedIn() && isOwner(userId);
      // Create permissions: only the owner can create tasks.
      allow create: if isSignedIn() && isOwner(userId);
      // Update permissions: only the owner can update their own tasks.
      allow update: if isSignedIn() && isOwner(userId) && resource != null;
      // Delete permissions: only the owner can delete their own tasks.
      allow delete: if isSignedIn() && isOwner(userId) && resource != null;
    }

    /**
     * @description Allow public read access to checkins.  No write access allowed.
     * @path /checkins/{checkinId}
     * @allow (get, list) Any user can read checkin data.
     * @deny (create, update, delete) No user can create, update, or delete checkin data.
     * @principle Grants public read access while restricting write access.
     */
    match /checkins/{checkinId} {
      // Public read access.
      allow get, list: if true;
      // No write access.
      allow create, update, delete: if false;
    }

    /**
     * @description Allow public read access to checkouts.  No write access allowed.
     * @path /checkouts/{checkoutId}
     * @allow (get, list) Any user can read checkout data.
     * @deny (create, update, delete) No user can create, update, or delete checkout data.
     * @principle Grants public read access while restricting write access.
     */
    match /checkouts/{checkoutId} {
      // Public read access.
      allow get, list: if true;
      // No write access.
      allow create, update, delete: if false;
    }

    /**
     * @description Allow public read access to activities.  No write access allowed.
     * @path /activities/{activityId}
     * @allow (get, list) Any user can read activity data.
     * @deny (create, update, delete) No user can create, update, or delete activity data.
     * @principle Grants public read access while restricting write access.
     */
    match /activities/{activityId} {
      // Public read access.
      allow get, list: if true;
      // No write access.
      allow create, update, delete: if false;
    }

    /**
     * @description Allow public read access to programs. No write access allowed.
     * @path /programs/{programId}
     * @allow (get, list) Any user can read program data.
     * @deny (create, update, delete) No user can create, update, or delete program data.
     * @principle Grants public read access while restricting write access.
     */
    match /programs/{programId} {
      // Public read access.
      allow get, list: if true;
      // No write access.
      allow create, update, delete: if false;
    }

    /**
     * @description Allow public read access to partnerships. No write access allowed.
     * @path /partnerships/{partnershipId}
     * @allow (get, list) Any user can read partnership data.
     * @deny (create, update, delete) No user can create, update, or delete partnership data.
     * @principle Grants public read access while restricting write access.
     */
    match /partnerships/{partnershipId} {
      // Public read access.
      allow get, list: if true;
      // No write access.
      allow create, update, delete: if false;
    }

    /**
     * @description Allow public read access to impact metrics. No write access allowed.
     * @path /impact-metrics/{metricId}
     * @allow (get, list) Any user can read impact metric data.
     * @deny (create, update, delete) No user can create, update, or delete impact metric data.
     * @principle Grants public read access while restricting write access.
     */
    match /impact-metrics/{metricId} {
      // Public read access.
      allow get, list: if true;
      // No write access.
      allow create, update, delete: if false;
    }

     /**
     * @description Allow public read access to projects. No write access allowed.
     * @path /projects/{projectId}
     * @allow (get, list) Any user can read project data.
     * @deny (create, update, delete) No user can create, update, or delete project data.
     * @principle Grants public read access while restricting write access.
     */
    match /projects/{projectId} {
      // Public read access.
      allow get, list: if true;
      // No write access.
      allow create, update, delete: if false;
    }

    /**
     * @description Allow public read access to events. No write access allowed.
     * @path /events/{eventId}
     * @allow (get, list) Any user can read event data.
     * @deny (create, update, delete) No user can create, update, or delete event data.
     * @principle Grants public read access while restricting write access.
     */
    match /events/{eventId} {
      // Public read access.
      allow get, list: if true;
      // No write access.
      allow create, update, delete: if false;
    }

   /**
     * @description Allow public read access to alerts. No write access allowed.
     * @path /alerts/{alertId}
     * @allow (get, list) Any user can read alert data.
     * @deny (create, update, delete) No user can create, update, or delete alert data.
     * @principle Grants public read access while restricting write access.
     */
    match /alerts/{alertId} {
      // Public read access.
      allow get, list: if true;
      // No write access.
      allow create, update, delete: if false;
    }

    /**
     * @description Allow public read access to key results. No write access allowed.
     * @path /key-results/{keyResultId}
     * @allow (get, list) Any user can read key result data.
     * @deny (create, update, delete) No user can create, update, or delete key result data.
     * @principle Grants public read access while restricting write access.
     */
    match /key-results/{keyResultId} {
      // Public read access.
      allow get, list: if true;
      // No write access.
      allow create, update, delete: if false;
    }

     /**
     * @description Allow public read access to expenses. No write access allowed.
     * @path /expenses/{expenseId}
     * @allow (get, list) Any user can read expense data.
     * @deny (create, update, delete) No user can create, update, or delete expense data.
     */
    match /expenses/{expenseId} {
      // Public read access.
      allow get, list: if true;
      // No write access.
      allow create, update, delete: if false;
    }
  }

  // Helper function to determine if the user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }

  // Helper function to determine if the user is the owner of the resource.
  function isOwner(userId) {
    return request.auth.uid == userId;
  }
}