
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }

    match /users/{userId}/{subcollection}/{docId} {
      allow read, write: if isOwner(userId);
    }

    match /programs/{programId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Executive Director', 'Programs & Partnerships Manager', 'Operations & Field Manager', 'Administrator'];
    }

    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Executive Director', 'Operations & Field Manager', 'Administrator'];
    }

    match /partnerships/{partnershipId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Executive Director', 'Programs & Partnerships Manager', 'Resource Mobilization Lead', 'Administrator'];
    }

    match /partnerships/{partnershipId}/{subcollection}/{docId} {
      allow read, write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Executive Director', 'Programs & Partnerships Manager', 'Resource Mobilization Lead', 'Administrator'];
    }

    match /impact-metrics/{metricId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Executive Director', 'Administrator'];
    }

    match /equipment/{equipmentId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Executive Director', 'Operations & Field Manager', 'Administrator'];
    }

    match /task-templates/{templateId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Executive Director', 'Operations & Field Manager', 'Administrator'];
    }
    
    match /key-results/{keyResultId} {
        allow read: if request.auth != null;
        allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Executive Director' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrator';
    }
    
    match /checkins/{checkinId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if isOwner(resource.data.userId);
    }
    
    match /checkouts/{checkoutId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }
    
    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if isOwner(resource.data.userId);
    }
    
    match /workplans/{workplanId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if isOwner(resource.data.userId);
    }
    
    match /team-workplans/{planId} {
        allow read: if request.auth != null;
        allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Executive Director', 'Operations & Field Manager', 'Administrator'];
    }

    match /testimonies/{testimonyId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update, delete: if isOwner(resource.data.userId);
    }
    
    match /ai-feedback/{feedbackId} {
      allow read, write: if request.auth != null;
    }

    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Executive Director', 'Administrator', 'Operations & Field Manager'];
    }

    match /alerts/{alertId} {
      allow read: if request.auth != null && (resource.data.targetUserIds.size() == 0 || request.auth.uid in resource.data.targetUserIds);
      allow write: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Executive Director', 'Administrator'];
    }
    
    match /expenses/{expenseId} {
      allow read: if request.auth != null; // Simplified rule, client-side logic will filter
      allow list: if request.auth != null; // Simplified rule, client-side logic will filter
      allow create: if request.auth != null;
      allow update: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Executive Director', 'Programs & Partnerships Manager', 'Operations & Field Manager', 'Media & Finance Lead', 'Administrator'];
      allow delete: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Executive Director', 'Administrator'] || isOwner(resource.data.userId));
    }

    match /income/{incomeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Executive Director', 'Media & Finance Lead', 'Administrator'];
    }

    match /proposals/{proposalId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Executive Director', 'Resource Mobilization Lead', 'Administrator'];
    }
  }
}
