rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isManager(userId) {
      let userDoc = get(/databases/$(database)/documents/users/$(userId));
      return request.auth != null && userDoc.data.role in ['Executive Director', 'Programs & Partnerships Manager', 'Operations & Field Manager', 'Media & Finance Lead', 'Media & Communications Lead', 'Administrator', 'Resource Mobilization Lead'];
    }

    function isFinance(userId) {
      let userDoc = get(/databases/$(database)/documents/users/$(userId));
      return request.auth != null && userDoc.data.role in ['Executive Director', 'Media & Finance Lead', 'Media & Communications Lead', 'Administrator'];
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // USER PROFILES
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }

    // USER SUB-COLLECTIONS (private data)
    match /users/{userId}/{subcollection}/{docId} {
      allow read, write: if isOwner(userId);
    }

    // MANAGEMENT COLLECTIONS (Readable by all, Writable by Managers)
    match /programs/{programId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }
    match /partnerships/{partnershipId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }
     match /partnerships/{partnershipId}/{subcollection}/{docId} {
      allow read, write: if isManager(request.auth.uid);
    }
    match /impact-metrics/{metricId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }
    match /equipment/{equipmentId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }
     match /task-templates/{templateId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }
     match /key-results/{keyResultId} {
      allow read: if request.auth != null;
      allow write: if isManager(request.auth.uid);
    }

    // TEAM-WIDE USER-GENERATED CONTENT (Readable by all, owned writes)
    match /checkins/{checkinId} {
        allow read: if request.auth != null;
        allow create: if isOwner(request.resource.data.userId);
        allow update, delete: if isOwner(resource.data.userId);
    }
    match /checkouts/{checkoutId} {
        allow read: if request.auth != null;
        allow create: if isOwner(request.resource.data.userId);
        allow update, delete: if isOwner(resource.data.userId);
    }
     match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if isOwner(request.resource.data.userId);
        allow update, delete: if isOwner(resource.data.userId);
    }
    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
      
      // Composite index for UserPerformance query
      index on userId, loggedAt desc {}
    }
    match /workplans/{workplanId} {
      allow read: if request.auth != null;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }
     match /testimonies/{testimonyId} {
      allow read: if request.auth != null;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }
    match /feedback/{feedbackId} {
      allow read: if isManager(request.auth.uid);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isManager(request.auth.uid);
      allow delete: if isManager(request.auth.uid);
    }
    match /community-feedback/{feedbackId} {
       allow read, write: if request.auth != null;
    }
    match /events/{eventId} {
        allow read: if request.auth != null;
        allow write: if isManager(request.auth.uid);
    }
    
    // MEAL / DATA COLLECTION - Open access for any authenticated user
    match /school-visits/{visitId} {
       allow read, write: if request.auth != null;
    }
    match /tree-surveys/{surveyId} {
       allow read, write: if request.auth != null;
    }
    match /beneficiaries/{beneficiaryId} {
        allow read, write: if request.auth != null;
    }
     match /attendance-records/{recordId} {
        allow read, write: if request.auth != null;
    }
     match /baseline-surveys/{surveyId} {
        allow read, write: if request.auth != null;
    }
     match /endline-surveys/{surveyId} {
        allow read, write: if request.auth != null;
    }
    match /pads-distributions/{distributionId} {
       allow read, write: if request.auth != null;
    }
    match /mhm-trainings/{trainingId} {
       allow read, write: if request.auth != null;
    }
    match /environmental-clubs/{clubId} {
       allow read, write: if request.auth != null;
    }
    match /waste-audits/{auditId} {
       allow read, write: if request.auth != null;
    }
    match /slf-schools/{schoolId} {
       allow read, write: if request.auth != null;
    }
    match /slf-prefects/{prefectId} {
       allow read, write: if request.auth != null;
    }
    match /slf-trainings/{trainingId} {
       allow read, write: if request.auth != null;
    }
    match /prefect-performance/{performanceId} {
       allow read, write: if request.auth != null;
    }
     match /yoskills-circles/{circleId} {
      allow read, write: if request.auth != null;
    }
    match /yoskills-youth/{youthId} {
      allow read, write: if request.auth != null;
    }
    match /yoskills-sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }
    match /business-ideas/{ideaId} {
      allow read, write: if request.auth != null;
    }
    match /pitch-scores/{scoreId} {
      allow read, write: if request.auth != null;
    }
    match /business-progress/{progressId} {
      allow read, write: if request.auth != null;
    }
     match /ofa-players/{playerId} {
      allow read, write: if request.auth != null;
    }
    match /ofa-matches/{matchId} {
      allow read, write: if request.auth != null;
    }
    match /pulse-content/{contentId} {
      allow read, write: if request.auth != null;
    }
    match /essentials-production/{logId} {
      allow read, write: if request.auth != null;
    }
    match /essentials-sales/{saleId} {
      allow read, write: if request.auth != null;
    }
    match /essentials-inventory/{checkId} {
      allow read, write: if request.auth != null;
    }
    match /water-sources/{sourceId} {
      allow read, write: if request.auth != null;
    }
    match /wash-assessments/{assessmentId} {
      allow read, write: if request.auth != null;
    }
    match /yap-chapters/{chapterId} {
      allow read, write: if request.auth != null;
    }
    match /yap-reports/{reportId} {
      allow read, write: if request.auth != null;
    }
    match /seed-grant-applications/{applicationId} {
      allow read, write: if request.auth != null;
    }
    match /seed-grant-accountability/{reportId} {
      allow read, write: if request.auth != null;
    }
    match /ofa-teams/{teamId} {
      allow read, write: if request.auth != null;
    }
    match /ofa-volunteers/{volunteerId} {
      allow read, write: if request.auth != null;
    }

    // SCHOOL APPLICATIONS (Public write, Logged-in read)
    match /school-applications/{applicationId} {
        allow read: if isManager(request.auth.uid);
        allow create: if true;
        allow update, delete: if isManager(request.auth.uid);
    }


    // TEAM-WIDE PLANS (Writable by Managers)
    match /team-workplans/{planId} {
        allow read: if request.auth != null;
        allow write: if isManager(request.auth.uid);
    }


    // ALERTS (Corrected Rules)
    match /alerts/{alertId} {
      allow list: if request.auth != null;
      allow get: if request.auth != null && (resource.data.targetUserIds.size() == 0 || request.auth.uid in resource.data.targetUserIds);
      allow write: if isManager(request.auth.uid);
    }

    // FINANCIALS (Strictest Rules)
    match /expenses/{expenseId} {
      allow get: if request.auth != null && (isFinance(request.auth.uid) || resource.data.userId == request.auth.uid);
      allow list: if request.auth != null && isFinance(request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null && (isManager(request.auth.uid) || (request.resource.data.status == 'Acknowledged' && resource.data.userId == request.auth.uid));
      allow delete: if request.auth != null && (isFinance(request.auth.uid) || isOwner(resource.data.userId));
    }

    match /income/{incomeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isFinance(request.auth.uid);
    }
    
    match /proposals/{proposalId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isManager(request.auth.uid);
    }
  }
}
