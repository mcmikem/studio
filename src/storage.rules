rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures:
    // - Allow anyone to read.
    // - Only the owner can write their own profile picture.
    match /profile-pictures/{userId}/{fileName} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Testimony recordings:
    // - Allow any authenticated user to write (upload).
    // - Allow any authenticated user to read.
    match /testimonies/{userId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // OFA player photos:
    // - Allow any authenticated user to write (upload).
    // - Allow any authenticated user to read.
    match /ofa-player-photos/{userId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Beneficiary photos:
    // - Allow any authenticated user to write (upload).
    // - Allow any authenticated user to read.
    match /beneficiary-photos/{userId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Fallback for any other path. By default, deny all access.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
