rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow authenticated users to read and write in designated folders.
    // This is a simplified rule for an internal application.
    // For a public-facing app, you would have more granular control.
    match /{folder}/{userId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // A fallback rule to deny all other access.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
