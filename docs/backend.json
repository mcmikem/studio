

{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user within the Omuto Central application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user entity."
        },
        "role": {
          "type": "string",
          "description": "The user's role within the organization (e.g., Program Manager, Operations, Media, ED, Intern, Volunteer)."
        },
        "name": {
          "type": "string",
          "description": "The user's full name."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "photoURL": {
            "type": "string",
            "description": "URL to the user's profile picture."
        },
         "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Server timestamp of when the user profile was created."
        }
      },
      "required": [
        "id",
        "role",
        "name",
        "email",
        "createdAt"
      ]
    },
    "Program": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Program",
      "type": "object",
      "description": "Represents a core program or initiative of Omuto Foundation.",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the program (e.g., RED Campaign)."
        },
        "description": {
          "type": "string",
          "description": "A brief description of the program."
        },
        "lead": {
          "type": "string",
          "description": "The name of the team member leading the program."
        },
        "status": {
          "type": "string",
          "enum": ["On Track", "At Risk", "Delayed", "Completed"],
          "description": "The current status of the program."
        },
        "deadline": {
          "type": "string",
          "description": "The target completion date for the program."
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "A list of key objectives for the program."
        },
        "valuePerObjective": {
          "type": "number",
          "description": "The monetary value (in UGX) assigned to completing one objective of this program."
        },
        "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Server timestamp of when the program was created."
        }
      },
      "required": ["title", "description", "lead", "status", "deadline", "objectives", "createdAt"]
    },
    "Partnership": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Partnership",
      "type": "object",
      "description": "Represents a partnership with another organization.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the partner organization."
        },
        "contactPerson": {
          "type": "string",
          "description": "The primary contact at the partner organization."
        },
        "contactEmail": {
          "type": "string",
          "format": "email",
          "description": "The email address of the primary contact."
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Potential", "Inactive"],
          "description": "The current status of the partnership."
        },
        "nextStep": {
          "type": "string",
          "description": "The next actionable step for this partnership."
        },
         "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Server timestamp of when the partnership was created."
        }
      },
      "required": ["name", "contactPerson", "contactEmail", "status", "nextStep", "createdAt"]
    },
    "Activity": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Activity",
      "type": "object",
      "description": "Represents a specific activity or task performed by Omuto staff, logged via the ROI Calculator.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the activity entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User who logged the activity."
        },
        "userName": {
          "type": "string",
          "description": "Name of the user who logged the activity."
        },
        "title": {
          "type": "string",
          "description": "The title of the activity (e.g., Tree Planting at St. Mary's)."
        },
        "ecosystem_phase": {
            "type": "string",
            "enum": ["Identify & Inspire", "Equip & Empower", "Activate & Sustain"],
            "description": "The ecosystem phase this activity belongs to."
        },
        "primaryGoalType": {
          "type": "string",
          "enum": ["Metric", "Program"],
          "description": "The type of the primary goal (either a KPI Metric or a Program objective)."
        },
        "primaryGoalId": {
          "type": "string",
          "description": "The ID of the selected Metric or Program."
        },
        "primaryGoalQuantity": {
          "type": "number",
          "description": "The quantity achieved for the primary goal (e.g., number of students, number of objectives)."
        },
        "estimatedCost": {
          "type": "number",
          "description": "The pre-activity estimated cost."
        },
        "actualCost": {
          "type": "number",
          "description": "The post-activity actual final cost."
        },
        "directValue": {
          "type": "number",
          "description": "The direct value generated by the activity's primary goal."
        },
        "indirectValue": {
          "type": "number",
          "description": "The additional value from ROI multipliers."
        },
        "totalValue": {
          "type": "number",
          "description": "The total value created (direct + indirect)."
        },
        "estimatedRoi": {
          "type": "number",
          "description": "The estimated Return on Investment percentage."
        },
        "finalRoi": {
          "type": "number",
          "description": "The final Return on Investment percentage after the activity."
        },
        "loggedAt": {
          "type": "string",
          "description": "Server timestamp of when the activity was logged.",
          "format": "date-time"
        },
        "parents_attended": {
            "type": "number",
            "description": "Number of parents reached in a RED Campaign session."
        },
        "teachers_attended": {
            "type": "number",
            "description": "Number of teachers reached in a RED Campaign session."
        }
      },
      "required": [
        "userId",
        "userName",
        "title",
        "ecosystem_phase",
        "primaryGoalId",
        "primaryGoalType",
        "primaryGoalQuantity",
        "estimatedCost",
        "actualCost",
        "directValue",
        "indirectValue",
        "totalValue",
        "estimatedRoi",
        "finalRoi",
        "loggedAt"
      ]
    },
    "Checkout": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Checkout",
      "type": "object",
      "description": "Represents a user's end-of-day checkout update.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the checkout."
        },
        "userId": {
          "type": "string",
          "description": "The ID of the user submitting the checkout."
        },
        "name": {
          "type": "string",
          "description": "The name of the user."
        },
        "role": {
          "type": "string",
          "description": "The role of the user (e.g., ED, PPM, OPM)."
        },
        "avatar": {
          "type": "string",
          "description": "URL to the user's avatar image."
        },
        "task": {
          "type": "string",
          "description": "The primary checkout message or task update summary."
        },
        "learning": {
            "type": "string",
            "description": "Key learnings or what to do differently next time."
        },
        "tomorrowPlan": {
            "type": "string",
            "description": "The user's stated priority for the next day."
        },
        "timestamp": {
          "type": "string",
          "description": "Server timestamp of when the checkout was submitted.",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "name",
        "role",
        "task",
        "timestamp"
      ]
    },
    "Checkin": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Checkin",
      "type": "object",
      "description": "Represents a user's start-of-day check-in and plan.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "primaryMission": { "type": "string" },
        "details": {
          "type": "object",
           "properties": {
              "timeBlocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "startTime": { "type": "string" },
                    "endTime": { "type": "string" },
                    "description": { "type": "string" }
                  },
                  "required": ["startTime", "endTime", "description"]
                }
              },
              "multiWinConnections": { "type": "array", "items": { "type": "string" } },
              "materials": { "type": "string" },
              "challenges": { "type": "string" },
              "bestPractice": { "type": "string" }
            }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "primaryMission", "details", "timestamp"]
    },
    "Task": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Task",
      "type": "object",
      "description": "Represents a single task or to-do item for a user.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "completed": { "type": "boolean" },
        "dueDate": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "completed", "createdAt"]
    },
    "TaskTemplate": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Task Template",
      "type": "object",
      "description": "A reusable checklist for common tasks.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "checklistItems": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "checklistItems", "createdAt"]
    },
    "Project": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Project",
      "type": "object",
      "description": "Represents a high-level project with its own dashboard and metrics.",
      "properties": {
        "name": { "type": "string" },
        "manager": { "type": "string" },
        "districts": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Moderate", "At Risk", "Delayed"] },
        "completion": { "type": "number" },
        "nextMilestone": { "type": "string" },
        "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Server timestamp of when the project was created."
        }
      },
      "required": ["name", "manager", "status", "completion", "nextMilestone", "createdAt"]
    },
    "ImpactMetric": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ImpactMetric",
      "type": "object",
      "description": "Represents a single, trackable impact metric.",
      "properties": {
        "metric": { "type": "string" },
        "target": { "type": "number" },
        "current": { "type": "number" },
        "unit": { "type": "string" },
        "valuePerUnit": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["metric", "target", "current", "createdAt"]
    },
    "CalendarEvent": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "CalendarEvent",
        "type": "object",
        "description": "Represents a single event on the organizational calendar.",
        "properties": {
            "title": { "type": "string" },
            "date": { "type": "string", "format": "date-time" },
            "category": { "type": "string", "enum": ["Team Meetings", "Field Visits", "Campaigns/Events", "Deadlines", "Social Days"] },
            "location": { "type": "string" },
            "responsible": { "type": "string" },
            "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["title", "date", "category", "location", "responsible", "createdAt"]
    },
    "Alert": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Alert",
      "type": "object",
      "description": "Represents an alert or notification for users.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Urgent", "Reminder", "Info"]
        },
        "message": { "type": "string" },
        "priority": {
          "type": "string",
          "enum": ["High", "Medium", "Low"]
        },
        "action": {
          "type": "string",
          "description": "A URL link for the alert's call to action."
        },
        "creatorId": {
          "type": "string",
          "description": "The ID of the user who triggered the alert."
        },
        "createdAt": {
            "type": "string",
            "format": "date-time"
        }
      },
      "required": ["type", "message", "priority", "action", "creatorId", "createdAt"]
    },
    "KeyResult": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Key Result",
      "description": "A key result from the October Operational Plan.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "description": "e.g., OCT-KR1" },
        "description": { "type": "string" },
        "currentProgress": { "type": "number" },
        "target": { "type": "number" },
        "deadline": { "type": "string", "format": "date" },
        "priority": { "type": "string", "enum": ["High", "Medium", "Low"] }
      },
      "required": ["title", "description", "currentProgress", "target", "deadline", "priority"]
    },
    "Expense": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Expense",
      "description": "Represents a single expense report with multiple line items.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "title": { "type": "string", "description": "The overall title of the expense report (e.g., Mpigi Field Visit)." },
        "type": {
            "type": "string",
            "enum": ["Requisition", "Reimbursement"],
            "description": "The type of expense report (pre-spending or post-spending)."
        },
        "items": {
          "type": "array",
          "description": "A list of individual expense items.",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "category": { "type": "string", "enum": ["Transport", "Materials", "Food", "Airtime", "Other"] },
              "amount": { "type": "number" }
            },
            "required": ["description", "category", "amount"]
          }
        },
        "totalAmount": { "type": "number", "description": "The sum of all item amounts." },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected", "Cleared"], "default": "Pending"},
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "date", "title", "type", "items", "totalAmount", "status", "createdAt"]
    },
    "Income": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Income",
      "description": "Represents a single income or revenue entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "amount": { "type": "number" },
        "dateReceived": { "type": "string", "format": "date" },
        "type": { "type": "string", "enum": ["Grant", "Donation", "Sales", "Other"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["source", "amount", "dateReceived", "type", "createdAt"]
    },
    "Proposal": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Proposal",
      "description": "Represents a single grant proposal or funding application.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "partnerName": { "type": "string" },
        "amountRequested": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Submitted", "In Review", "Approved", "Rejected"] },
        "submissionDate": { "type": "string", "format": "date" },
        "decisionDate": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "partnerName", "amountRequested", "status", "submissionDate", "createdAt"]
    },
    "TeamWeeklyPlan": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Team Weekly Plan",
      "description": "A manager-created plan with high-level priorities for the entire team for a specific week.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "weekOf": { "type": "string", "format": "date", "description": "The start date of the week (e.g., a Monday)." },
        "keyPriorities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "A list of the main team priorities for the week."
        },
        "message": { "type": "string", "description": "A brief message or focus from the manager for the week." },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "Published"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["weekOf", "keyPriorities", "authorId", "authorName", "status", "createdAt"]
    },
    "WeeklyWorkplan": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Weekly Workplan",
      "description": "Represents a user's finalized strategic plan for a specific week, built upon the team's plan.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "weekOf": { "type": "string", "format": "date" },
        "teamPlanId": { "type": "string", "description": "Reference to the TeamWeeklyPlan for that week." },
        "teamPriorities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "The inherited team priorities for the week."
        },
        "individualTasks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "The user's individual tasks contributing to the team priorities."
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "weekOf", "teamPlanId", "teamPriorities", "individualTasks", "createdAt"]
    },
    "Equipment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Equipment",
      "description": "Represents a piece of physical equipment or an asset.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["Available", "In Use", "Under Maintenance"] },
        "condition": { "type": "string", "enum": ["Good", "Fair", "Poor"] },
        "currentHolder": { "type": "string" },
        "purchaseDate": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "status", "condition", "currentHolder", "createdAt"]
    },
    "Message": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "Message",
        "description": "Represents a single chat message in the team space.",
        "type": "object",
        "properties": {
            "id": { "type": "string" },
            "text": { "type": "string" },
            "userId": { "type": "string" },
            "userName": { "type": "string" },
            "userAvatar": { "type": "string", "format": "uri" },
            "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["text", "userId", "userName", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "google.com"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profile information."
    },
    "/users/{userId}/tasks/{taskId}": {
        "schema": {
            "$ref": "#/entities/Task"
        },
        "description": "Stores tasks for a specific user."
    },
    "/checkins/{checkinId}": {
      "schema": {
        "$ref": "#/entities/Checkin"
      },
      "description": "Stores daily check-in plans from team members."
    },
    "/checkouts/{checkoutId}": {
      "schema": {
        "$ref": "#/entities/Checkout"
      },
      "description": "Stores daily checkout updates from team members."
    },
    "/activities/{activityId}": {
      "schema": {
        "$ref": "#/entities/Activity"
      },
      "description": "Stores logged activities from the ROI Calculator."
    },
    "/programs/{programId}": {
      "schema": {
        "$ref": "#/entities/Program"
      },
      "description": "Stores Omuto's core programs and initiatives."
    },
    "/partnerships/{partnershipId}": {
      "schema": {
        "$ref": "#/entities/Partnership"
      },
      "description": "Stores information about partner organizations."
    },
    "/impact-metrics/{metricId}": {
      "schema": {
        "$ref": "#/entities/ImpactMetric"
      },
      "description": "Stores key performance indicators (KPIs) for the organization."
    },
     "/projects/{projectId}": {
      "schema": {
        "$ref": "#/entities/Project"
      },
      "description": "Stores high-level projects and their associated metrics."
    },
    "/events/{eventId}": {
        "schema": {
            "$ref": "#/entities/CalendarEvent"
        },
        "description": "Stores organizational calendar events."
    },
    "/alerts/{alertId}": {
        "schema": {
            "$ref": "#/entities/Alert"
        },
        "description": "Stores system-wide alerts and notifications."
    },
    "/key-results/{keyResultId}": {
      "schema": {
        "$ref": "#/entities/KeyResult"
      },
      "description": "Stores the key results for the October Operational Plan."
    },
    "/expenses/{expenseId}": {
      "schema": {
        "$ref": "#/entities/Expense"
      },
      "description": "Stores expense reports submitted by users."
    },
    "/income/{incomeId}": {
      "schema": {
        "$ref": "#/entities/Income"
      },
      "description": "Stores all income and revenue transactions."
    },
    "/proposals/{proposalId}": {
      "schema": {
        "$ref": "#/entities/Proposal"
      },
      "description": "Stores grant proposals and funding applications."
    },
     "/team-workplans/{teamWorkplanId}": {
      "schema": {
        "$ref": "#/entities/TeamWeeklyPlan"
      },
      "description": "Stores manager-created team-wide weekly plans."
    },
    "/workplans/{workplanId}": {
      "schema": {
        "$ref": "#/entities/WeeklyWorkplan"
      },
      "description": "Stores individuals' finalized weekly workplans."
    },
    "/equipment/{equipmentId}": {
      "schema": {
        "$ref": "#/entities/Equipment"
      },
      "description": "Stores the inventory of physical equipment."
    },
    "/task-templates/{templateId}": {
      "schema": {
        "$ref": "#/entities/TaskTemplate"
      },
      "description": "Stores reusable task templates and checklists."
    },
    "/messages/{messageId}": {
        "schema": {
            "$ref": "#/entities/Message"
        },
        "description": "Stores team chat messages."
    }
  }
}

