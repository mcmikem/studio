rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures
    match /profile-pictures/{userId}/{fileName} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Beneficiary photos
    match /beneficiary-photos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Testimony recordings/media
    match /testimonies/{userId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // OFA player photos
    match /ofa-player-photos/{teamId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Expense receipts
    match /expense-receipts/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Activity media
    match /activity-media/{userId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
